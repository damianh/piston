<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <InternalsVisibleTo Include="Piston.Engine.Tests" />
    <InternalsVisibleTo Include="Piston.ExecutionLeaseHolder" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>

  <!-- Ship the VSTest live-events collector in a dedicated collectors/ folder (passed as the test adapter path). -->
  <ItemGroup>
    <ProjectReference Include="..\Piston.LiveCollector\Piston.LiveCollector.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="PistonLiveCollectorAssembly" />
    <ProjectReference Include="..\Piston.ProcessHost\Piston.ProcessHost.csproj" />
  </ItemGroup>
  <Target Name="IncludePistonLiveCollector" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <None Include="@(PistonLiveCollectorAssembly)"
            Link="collectors\%(Filename)%(Extension)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <None Include="..\Piston.ProcessHost\bin\$(Configuration)\$(TargetFramework)\Piston.ProcessHost.runtimeconfig.json"
          Link="Piston.ProcessHost.runtimeconfig.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
