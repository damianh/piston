<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Transitive dep Microsoft.Build.Tasks.Core has a known vulnerability; suppressed until upstream fixes -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <!-- MSBuild packages come transitively from Microsoft.CodeAnalysis.Workspaces.MSBuild;
         MSBuild.Locator handles assembly loading at runtime -->
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Microsoft.Build.Locator" />
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Piston.Roslyn\Piston.Roslyn.csproj" />
  </ItemGroup>
</Project>
