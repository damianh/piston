@using System.Text.Json.Nodes

<div class="flex flex-col border-b border-gray-900 hover:bg-gray-900 transition-colors @(HasDetail ? "cursor-pointer" : "")"
     @onclick="ToggleExpand">
    <div class="flex items-center gap-2 px-4 py-1 text-xs">
        <span class="shrink-0 w-5 text-center text-sm @IconColor" title="@Event.Type">@Icon</span>
        <span class="text-gray-500 shrink-0 tabular-nums">@Event.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
        @if (IsMcp)
        {
            <span class="shrink-0 font-mono text-gray-100">@Str("toolName")</span>
            @if (!Succeeded)
            {
                <span class="shrink-0 text-red-400">failed</span>
            }
            <span class="truncate font-mono text-gray-500">@Str("paramsSummary")</span>
        }
        else
        {
            <span class="truncate text-gray-300">@Summary</span>
        }
        <span class="ml-auto flex items-center gap-2 shrink-0">
            @if (RepeatCount > 1)
            {
                <span class="px-1.5 rounded bg-gray-800 text-gray-400 tabular-nums" title="@RepeatCount identical consecutive calls">×@RepeatCount</span>
            }
            @if (Duration is { } ms)
            {
                <span class="text-yellow-600 tabular-nums">@FormatDuration(ms)</span>
            }
            <span class="w-3 text-gray-600">@(HasDetail ? (_expanded ? "▲" : "▼") : "")</span>
        </span>
    </div>

    @if (_expanded && HasDetail)
    {
        <div class="pl-[4.75rem] pr-4 pb-2 text-xs text-gray-400 whitespace-pre-wrap font-mono max-h-64 overflow-y-auto">@DetailText</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ActivityEvent Event { get; set; } = default!;
    [Parameter] public int RepeatCount { get; set; } = 1;

    private bool _expanded;

    private bool IsMcp => Event.Type == ActivityEventTypes.McpToolCall;
    private bool Succeeded => Event.Data?["succeeded"]?.GetValue<bool>() ?? false;

    private string? Str(string key) => Event.Data?[key]?.GetValue<string>();
    private int Int(string key) => Event.Data?[key]?.GetValue<int>() ?? 0;

    private double? Duration => Event.Type is ActivityEventTypes.BuildCompleted
        or ActivityEventTypes.TestRunCompleted or ActivityEventTypes.McpToolCall
        ? Event.Data?["durationMs"]?.GetValue<double>()
        : null;

    private string Icon => Event.Type switch
    {
        ActivityEventTypes.SolutionLoaded      => "📂",
        ActivityEventTypes.FileChangesDetected => "📝",
        ActivityEventTypes.BuildCompleted      => "🔨",
        ActivityEventTypes.TestRunCompleted    => "🧪",
        ActivityEventTypes.McpToolCall         => "⚡",
        _                                      => "•",
    };

    private string IconColor => Event.Type switch
    {
        ActivityEventTypes.BuildCompleted when !Succeeded                     => "text-red-400",
        ActivityEventTypes.TestRunCompleted when Int("failed") > 0            => "text-red-400",
        ActivityEventTypes.McpToolCall when !Succeeded                        => "text-red-400",
        ActivityEventTypes.BuildCompleted or ActivityEventTypes.TestRunCompleted => "text-green-400",
        _                                                                     => "text-blue-400",
    };

    private string Summary => Event.Type switch
    {
        ActivityEventTypes.SolutionLoaded      => FormatSolutionLoaded(),
        ActivityEventTypes.FileChangesDetected => $"{Int("count")} file(s) changed",
        ActivityEventTypes.BuildCompleted      => Succeeded ? "Build succeeded" : $"Build failed — {Int("errorCount")} error(s)",
        ActivityEventTypes.TestRunCompleted    => $"Tests: {Int("passed")} passed, {Int("failed")} failed, {Int("skipped")} skipped",
        ActivityEventTypes.Reconnect           => "Reconnected",
        _                                      => Event.Type,
    };

    private bool HasDetail => DetailText.Length > 0;

    private string DetailText => Event.Type switch
    {
        ActivityEventTypes.BuildCompleted when Event.Data?["errors"] is JsonArray errs && errs.Count > 0
            => AddOmittedDetails(string.Join("\n", errs.Select(e => e?.ToString() ?? "")), errs.Count, Int("errorCount"), "error(s)"),
        ActivityEventTypes.TestRunCompleted when Event.Data?["failures"] is JsonArray fails && fails.Count > 0
            => AddOmittedDetails(string.Join("\n\n", fails.Select(f =>
                $"{f?["fullyQualifiedName"]?.GetValue<string>()}\n  {f?["message"]?.GetValue<string>()}")), fails.Count, Int("failed"), "failure(s)"),
        ActivityEventTypes.FileChangesDetected when Event.Data?["changedFiles"] is JsonArray files && files.Count > 0
            => string.Join("\n", files.Select(f => f?.ToString() ?? "")),
        ActivityEventTypes.McpToolCall
            => FormatMcpDetail(),
        _ => string.Empty,
    };

    private static string AddOmittedDetails(string text, int shown, int total, string kind) =>
        total > shown ? $"{text}\n… and {total - shown} more {kind} omitted" : text;

    private void ToggleExpand()
    {
        if (HasDetail) _expanded = !_expanded;
    }

    private string FormatSolutionLoaded()
    {
        var path = Str("solutionPath") ?? Event.SolutionPath ?? "?";
        return $"Solution loaded — {Path.GetFileName(path)} ({Int("projectCount")} projects)";
    }

    private string FormatMcpDetail()
    {
        var parts = new List<string>();
        if (Str("paramsSummary") is { Length: > 0 } p) parts.Add($"params: {p}");
        if (Str("resultSummary") is { Length: > 0 } r) parts.Add($"result: {r}");
        return string.Join("\n", parts);
    }

    private static string FormatDuration(double ms) => ms switch
    {
        < 1      => "<1ms",
        < 1000   => $"{ms:F0}ms",
        < 60_000 => $"{ms / 1000:F1}s",
        _        => $"{ms / 60_000:F0}m {ms % 60_000 / 1000:F0}s",
    };
}
