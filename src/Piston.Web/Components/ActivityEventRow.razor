@using System.Text.Json.Nodes

<div class="flex flex-col border-b border-gray-900 hover:bg-gray-900 transition-colors cursor-pointer"
     @onclick="ToggleExpand">
    <div class="flex items-center gap-2 px-2 py-1 text-xs">
        <span class="shrink-0 text-base @IconColor" title="@Event.Type">@Icon</span>
        <span class="text-gray-500 shrink-0 tabular-nums">@Event.Timestamp.ToString("HH:mm:ss")</span>
        <span class="truncate text-gray-300">@Summary</span>
        @if (_expanded)
        {
            <span class="ml-auto text-gray-600">▲</span>
        }
        else if (HasDetail)
        {
            <span class="ml-auto text-gray-600">▼</span>
        }
    </div>

    @if (_expanded && HasDetail)
    {
        <div class="px-8 pb-2 text-xs text-gray-400 whitespace-pre-wrap font-mono max-h-64 overflow-y-auto">
            @DetailText
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ActivityEvent Event { get; set; } = default!;

    private bool _expanded;

    private string Icon => Event.Type switch
    {
        ActivityEventTypes.SolutionLoaded      => "📂",
        ActivityEventTypes.FileChangesDetected => "📝",
        ActivityEventTypes.BuildCompleted      => "🔨",
        ActivityEventTypes.TestRunCompleted    => "🧪",
        ActivityEventTypes.DiagnosticsChanged  => "⚠",
        ActivityEventTypes.McpToolCall         => "⚡",
        _                                      => "•",
    };

    private string IconColor => Event.Type switch
    {
        ActivityEventTypes.BuildCompleted when Event.Data?["succeeded"]?.GetValue<bool>() == false => "text-red-400",
        ActivityEventTypes.TestRunCompleted when Event.Data?["failed"]?.GetValue<int>() > 0         => "text-red-400",
        ActivityEventTypes.DiagnosticsChanged                                                       => "text-yellow-400",
        ActivityEventTypes.BuildCompleted                                                            => "text-green-400",
        ActivityEventTypes.TestRunCompleted                                                          => "text-green-400",
        _                                                                                            => "text-blue-400",
    };

    private string Summary => Event.Type switch
    {
        ActivityEventTypes.SolutionLoaded      => FormatSolutionLoaded(),
        ActivityEventTypes.FileChangesDetected => FormatFileChanges(),
        ActivityEventTypes.BuildCompleted      => FormatBuild(),
        ActivityEventTypes.TestRunCompleted    => FormatTestRun(),
        ActivityEventTypes.DiagnosticsChanged  => FormatDiagnostics(),
        ActivityEventTypes.McpToolCall         => FormatMcpCall(),
        _                                      => Event.Type,
    };

    private bool HasDetail => DetailText.Length > 0;

    private string DetailText => Event.Type switch
    {
        ActivityEventTypes.BuildCompleted when Event.Data?["errors"] is JsonArray errs && errs.Count > 0
            => string.Join("\n", errs.Select(e => e?.ToString() ?? "")),
        ActivityEventTypes.TestRunCompleted when Event.Data?["failures"] is JsonArray fails && fails.Count > 0
            => string.Join("\n\n", fails.Select(f =>
                $"{f?["fullyQualifiedName"]?.GetValue<string>()}\n  {f?["message"]?.GetValue<string>()}")),
        ActivityEventTypes.DiagnosticsChanged
            => FormatDiagnosticDetail(),
        ActivityEventTypes.McpToolCall
            => FormatMcpDetail(),
        _ => string.Empty,
    };

    private void ToggleExpand()
    {
        if (HasDetail) _expanded = !_expanded;
    }

    private string FormatSolutionLoaded()
    {
        var path = Event.Data?["solutionPath"]?.GetValue<string>() ?? Event.SolutionPath ?? "?";
        var count = Event.Data?["projectCount"]?.GetValue<int>() ?? 0;
        return $"Solution loaded — {Path.GetFileName(path)} ({count} projects)";
    }

    private string FormatFileChanges()
    {
        var count = Event.Data?["fileCount"]?.GetValue<int>() ?? 0;
        return $"File changes detected — {count} file(s)";
    }

    private string FormatBuild()
    {
        var ok  = Event.Data?["succeeded"]?.GetValue<bool>() ?? false;
        var ms  = Event.Data?["durationMs"]?.GetValue<double>() ?? 0;
        var err = Event.Data?["errorCount"]?.GetValue<int>() ?? 0;
        return ok
            ? $"Build succeeded in {ms:F0}ms"
            : $"Build failed — {err} error(s) in {ms:F0}ms";
    }

    private string FormatTestRun()
    {
        var passed  = Event.Data?["passed"]?.GetValue<int>() ?? 0;
        var failed  = Event.Data?["failed"]?.GetValue<int>() ?? 0;
        var skipped = Event.Data?["skipped"]?.GetValue<int>() ?? 0;
        var ms      = Event.Data?["durationMs"]?.GetValue<double>() ?? 0;
        return $"Tests: {passed} passed, {failed} failed, {skipped} skipped — {ms:F0}ms";
    }

    private string FormatDiagnostics()
    {
        var added   = (Event.Data?["added"]   as JsonArray)?.Count ?? 0;
        var removed = (Event.Data?["removed"] as JsonArray)?.Count ?? 0;
        return $"Diagnostics changed — +{added} / -{removed}";
    }

    private string FormatMcpCall()
    {
        var tool = Event.Data?["toolName"]?.GetValue<string>() ?? "?";
        var ms   = Event.Data?["durationMs"]?.GetValue<double>() ?? 0;
        var ok   = Event.Data?["succeeded"]?.GetValue<bool>() ?? false;
        return $"MCP: {tool} — {ms:F0}ms {(ok ? "✓" : "✗")}";
    }

    private string FormatDiagnosticDetail()
    {
        var added   = Event.Data?["added"]   as JsonArray;
        var removed = Event.Data?["removed"] as JsonArray;
        var lines = new List<string>();
        if (added is not null)
            foreach (var d in added) lines.Add($"+ [{d?["severity"]}] {d?["id"]}: {d?["message"]}");
        if (removed is not null)
            foreach (var d in removed) lines.Add($"- [{d?["severity"]}] {d?["id"]}: {d?["message"]}");
        return string.Join("\n", lines);
    }

    private string FormatMcpDetail()
    {
        var @params = Event.Data?["paramsSummary"]?.GetValue<string>();
        var result  = Event.Data?["resultSummary"]?.GetValue<string>();
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(@params)) parts.Add($"Params: {@params}");
        if (!string.IsNullOrEmpty(result))  parts.Add($"Result: {result}");
        return string.Join("\n", parts);
    }
}
