@inject EngineClientService Client
@inject NavigationManager Nav
@inject ViewState ViewState
@inject IJSRuntime JS
@implements IDisposable

<ConnectionOverlay IsConnected="@Client.IsConnected" IsConnecting="@Client.IsConnecting" />

<div class="flex h-screen bg-gray-950 text-gray-100 font-sans text-sm overflow-hidden"
     @onkeydown="HandleKeyDown" tabindex="0" @ref="_rootElement">

    <div class="flex flex-1 flex-col overflow-hidden">
        <SolutionDetail KeyboardEvent="@_lastKeyDown" />
    </div>
</div>

<ShortcutsDialog IsOpen="@_shortcutsOpen" OnClose="CloseShortcuts" />

<!-- Announces when a run starts and finishes, for screen readers -->
<div class="sr-only" role="status" aria-live="polite" aria-atomic="true">@_announcement</div>

@code {
    private ElementReference _rootElement;
    private KeyboardEventArgs? _lastKeyDown;
    private bool _shortcutsOpen;
    private string? _announcement;
    private StateSnapshotNotification? _previousSnapshot;
    private string? _shownTitle;

    protected override async Task OnInitializedAsync()
    {
        Client.ConnectionStateChanged += OnConnectionStateChanged;
        Client.SettingsChanged += OnSettingsChanged;
        Client.StateChanged += OnStateChanged;

        var wsUrl = BuildWsUrl();
        await Client.StartAsync(wsUrl);
    }

    private string BuildWsUrl()
    {
        var baseUri = new Uri(Nav.BaseUri);
        var scheme  = baseUri.Scheme == "https" ? "wss" : "ws";
        return $"{scheme}://{baseUri.Host}:{baseUri.Port}/ws";
    }

    private void OnConnectionStateChanged() => InvokeAsync(async () =>
    {
        await ShowStatusAsync();
        StateHasChanged();
    });

    private void OnStateChanged(StateSnapshotNotification snapshot) => InvokeAsync(async () =>
    {
        if (DashboardStatus.Announcement(_previousSnapshot, snapshot) is { } announcement)
        {
            _announcement = announcement;
            StateHasChanged();
        }

        _previousSnapshot = snapshot;
        await ShowStatusAsync();
    });

    // The tab title and favicon show the run state while the dashboard is in a background tab.
    private async Task ShowStatusAsync()
    {
        var snapshot = Client.CurrentSnapshot;
        var title = DashboardStatus.Title(snapshot, Client.IsConnected);
        var icon = DashboardStatus.Icon(snapshot, Client.IsConnected);
        if ($"{title}|{icon}" == _shownTitle)
        {
            return;
        }

        _shownTitle = $"{title}|{icon}";
        try
        {
            await JS.InvokeVoidAsync("pistonStatus.set", title, icon);
        }
        catch (JSException)
        {
            // Cosmetic only; never let it break the dashboard.
        }
    }

    private void CloseShortcuts() => _shortcutsOpen = false;

    private void OnSettingsChanged() => InvokeAsync(() =>
    {
        ViewState.ApplySettings(Client.Settings.Dashboard);
        StateHasChanged();
    });

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "?")
        {
            _shortcutsOpen = true;
            return;
        }

        _lastKeyDown = e;
        StateHasChanged();
    }

    public void Dispose()
    {
        Client.ConnectionStateChanged -= OnConnectionStateChanged;
        Client.SettingsChanged -= OnSettingsChanged;
        Client.StateChanged -= OnStateChanged;
    }
}
