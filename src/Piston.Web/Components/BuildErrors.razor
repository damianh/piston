@using Piston.Protocol.Dtos

@if (Build is not null && (Build.Errors.Count > 0 || Build.OmittedErrors > 0))
{
    <div class="flex flex-col h-full overflow-y-auto p-4 gap-3 text-xs">
        <div class="text-red-400 font-semibold">Build Failed — @TotalErrors error@(TotalErrors == 1 ? "" : "s")</div>
        @foreach (var error in Build.Errors)
        {
            <div class="bg-gray-900 border border-red-900 rounded p-3">
                <pre class="text-red-300 whitespace-pre-wrap break-all">@error</pre>
            </div>
        }
        @if (Build.OmittedErrors > 0)
        {
            <div class="text-gray-500">@Build.OmittedErrors additional error(s) omitted</div>
        }
        @if (Build.Warnings.Count > 0 || Build.OmittedWarnings > 0)
        {
            <div class="text-yellow-400 font-semibold mt-2">@TotalWarnings warning@(TotalWarnings == 1 ? "" : "s")</div>
            @foreach (var warning in Build.Warnings)
            {
                <div class="bg-gray-900 border border-yellow-900 rounded p-3">
                    <pre class="text-yellow-300 whitespace-pre-wrap break-all">@warning</pre>
                </div>
            }
            @if (Build.OmittedWarnings > 0)
            {
                <div class="text-gray-500">@Build.OmittedWarnings additional warning(s) omitted</div>
            }
        }
    </div>
}

@code {
    [Parameter] public BuildResultDto? Build { get; set; }

    private int TotalErrors => Build!.Errors.Count + Build.OmittedErrors;
    private int TotalWarnings => Build!.Warnings.Count + Build.OmittedWarnings;
}
