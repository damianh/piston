@inject EngineClientService Client
@implements IDisposable

<div class="flex flex-col h-full overflow-hidden">
    <div class="px-3 py-2 border-b border-gray-800 text-xs text-gray-500 flex justify-between items-center">
        <span>Diagnostics (@_diagnostics.Count)</span>
        <button class="text-gray-600 hover:text-gray-400 transition-colors" @onclick="Refresh" title="Refresh">↻</button>
    </div>

    @if (_loading)
    {
        <div class="p-4 text-xs text-gray-600 italic">Loading…</div>
    }
    else if (_diagnostics.Count == 0)
    {
        <div class="p-4 text-xs text-gray-600 italic">No diagnostics found.</div>
    }
    else
    {
        <div class="flex-1 overflow-y-auto text-xs">
            @foreach (var group in _grouped)
            {
                <div class="px-3 py-1 bg-gray-900 text-gray-400 font-semibold border-b border-gray-800 sticky top-0">
                    @group.Key
                </div>
                @foreach (var d in group)
                {
                    <div class="flex items-start gap-2 px-3 py-1 border-b border-gray-900 hover:bg-gray-900">
                        <span class="shrink-0 @SeverityClass(d.Severity)" title="@d.Severity">
                            @SeverityIcon(d.Severity)
                        </span>
                        <div class="flex flex-col gap-0.5 min-w-0">
                            <span class="text-gray-300 truncate">@d.Message</span>
                            <span class="text-gray-600 truncate">
                                @d.Id &nbsp;@d.FilePath:@d.Line:@d.Column
                            </span>
                        </div>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    private List<DiagnosticEntryData> _diagnostics = [];
    private bool _loading;
    private IEnumerable<IGrouping<string, DiagnosticEntryData>> _grouped = [];

    protected override async Task OnInitializedAsync()
    {
        Client.ActivityEventReceived += OnActivityEvent;
        await LoadDiagnosticsAsync();
    }

    private async Task LoadDiagnosticsAsync()
    {
        _loading = true;
        StateHasChanged();

        var response = await Client.GetDiagnosticsAsync().ConfigureAwait(false);
        _diagnostics = response?.Diagnostics?.ToList() ?? [];
        RebuildGrouped();

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    private void RebuildGrouped() =>
        _grouped = _diagnostics
            .OrderBy(d => d.Severity == "Error" ? 0 : 1)
            .GroupBy(d => d.FilePath ?? "Unknown");

    private void OnActivityEvent(ActivityEvent evt)
    {
        if (evt.Type != ActivityEventTypes.DiagnosticsChanged)
            return;

        var data = evt.Data is null ? null :
            System.Text.Json.JsonSerializer.Deserialize<DiagnosticsChangedData>(
                evt.Data.ToJsonString(),
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

        if (data is null) return;

        if (data.Removed is not null)
        {
            var removedSet = data.Removed.Select(r => r.Id + r.Message + r.FilePath).ToHashSet();
            _diagnostics.RemoveAll(d => removedSet.Contains(d.Id + d.Message + d.FilePath));
        }

        if (data.Added is not null)
            _diagnostics.AddRange(data.Added);

        RebuildGrouped();
        InvokeAsync(StateHasChanged);
    }

    private async Task Refresh() => await LoadDiagnosticsAsync();

    private static string SeverityIcon(string severity) => severity switch
    {
        "Error"   => "✗",
        "Warning" => "⚠",
        _         => "ℹ",
    };

    private static string SeverityClass(string severity) => severity switch
    {
        "Error"   => "text-red-400",
        "Warning" => "text-yellow-400",
        _         => "text-blue-400",
    };

    public void Dispose()
    {
        Client.ActivityEventReceived -= OnActivityEvent;
    }
}
