@using Piston.Protocol.Dtos
@inject EngineClientService Client
@implements IDisposable

<div class="flex items-center gap-4 pl-4 h-9 shrink-0 whitespace-nowrap overflow-hidden bg-gray-900 border-b border-gray-800 text-xs select-none">
    @if (Snapshot is null)
    {
        <span class="text-gray-600">⬡ Piston</span>
    }
    else
    {
        var solutionName = Snapshot.SolutionPath is not null
            ? Path.GetFileNameWithoutExtension(Snapshot.SolutionPath)
            : "Piston";
        <span class="shrink-0 text-gray-400 font-semibold" title="@Snapshot.SolutionPath">⬡ @solutionName</span>
    }
    <TabBar ActiveTab="@ActiveTab" OnTabSelected="OnTabSelected" />
    <div class="ml-auto mr-2 flex items-center gap-0.5">
        <ThemeToggle />
        <button @ref="_settingsButton" class="p-1.5 rounded text-gray-400 hover:text-gray-100 hover:bg-gray-800"
                title="Settings" aria-label="Settings" aria-haspopup="dialog" @onclick="OpenSettings">
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true">
                <path d="M12.72 6.35 L12.81 6.62 L14.48 6.74 L14.48 9.26 L12.81 9.38 L12.51 10.17 L12.37 10.42 L13.47 11.69 L11.69 13.47 L10.42 12.37 L9.65 12.72 L9.38 12.81 L9.26 14.48 L6.74 14.48 L6.62 12.81 L5.83 12.51 L5.58 12.37 L4.31 13.47 L2.53 11.69 L3.63 10.42 L3.28 9.65 L3.19 9.38 L1.52 9.26 L1.52 6.74 L3.19 6.62 L3.49 5.83 L3.63 5.58 L2.53 4.31 L4.31 2.53 L5.58 3.63 L6.35 3.28 L6.62 3.19 L6.74 1.52 L9.26 1.52 L9.38 3.19 L10.17 3.49 L10.42 3.63 L11.69 2.53 L13.47 4.31 L12.37 5.58Z" />
                <circle cx="8" cy="8" r="2" />
            </svg>
        </button>
    </div>
</div>

<SettingsDialog IsOpen="@_settingsOpen" OnClose="CloseSettings" />

@code {
    [Parameter, EditorRequired] public DashboardTab ActiveTab { get; set; }
    [Parameter, EditorRequired] public EventCallback<DashboardTab> OnTabSelected { get; set; }

    private StateSnapshotNotification? Snapshot { get; set; }

    private ElementReference _settingsButton;
    private bool _settingsOpen;
    private bool _returnFocus;

    private void OpenSettings() => _settingsOpen = true;

    // The modal keeps the page inert until it leaves the DOM, so focus the gear after re-render.
    private void CloseSettings()
    {
        _settingsOpen = false;
        _returnFocus = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_returnFocus)
        {
            _returnFocus = false;
            await _settingsButton.FocusAsync();
        }
    }

    protected override void OnInitialized()
    {
        Client.StateChanged += OnStateChanged;
        Snapshot = Client.CurrentSnapshot;
    }

    private void OnStateChanged(StateSnapshotNotification snapshot)
    {
        Snapshot = snapshot;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Client.StateChanged -= OnStateChanged;
}
