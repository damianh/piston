@* The status bar's run summary. While a run is active: what triggered it and which tests it runs (the phase and
   progress beside it say how far it got). Otherwise: the last run's trigger → build → scope → outcome, with its time. *@

@if (Run is { } run)
{
    var summary = WatchStrip.Summarize(run, SolutionDirectory);
    var active = Snapshot!.ActiveRun is not null;
    <span class="flex items-center gap-1.5 min-w-0 overflow-hidden" data-testid="run-summary">
        <span class="min-w-0 truncate text-gray-300" title="@(summary.TriggerDetail ?? run.Trigger)">@summary.Trigger</span>

        @if (!active && run.Restored)
        {
            <span class="shrink-0 text-yellow-400" title="@run.FreshnessReason">restored · not re-verified</span>
        }
        else if (!active && Snapshot.Suites.Any(s => s.Restored))
        {
            <span class="shrink-0 text-yellow-400" title="Some preserved test suites have not been re-verified since restart">some results not re-verified</span>
        }

        @if (!active && summary.Build is { } build)
        {
            <span class="shrink-0" aria-hidden="true">→</span>
            <span class="shrink-0 @(summary.BuildFailed ? "text-red-400" : "")">@build</span>
        }

        @if (summary.Scope is { } scope)
        {
            <span class="shrink-0" aria-hidden="true">→</span>
            <span class="min-w-0 truncate" title="@(run.SelectionExplanation ?? "Which tests the run ran")">@scope</span>
        }

        @if (!active && !summary.BuildFailed)
        {
            var fixedTests = run.FixedTests ?? [];
            var newlyFailing = run.NewlyFailingTests ?? [];
            <span class="shrink-0" aria-hidden="true">→</span>
            @if (fixedTests.Count > 0)
            {
                <button class="shrink-0 text-green-400 hover:underline" data-testid="run-summary-fixed"
                        title="@TestList("Fixed", fixedTests)" @onclick="() => OnRevealTest.InvokeAsync(fixedTests[0])">
                    ✓ @fixedTests.Count fixed
                </button>
            }
            @if (newlyFailing.Count > 0)
            {
                <button class="shrink-0 text-red-400 hover:underline" data-testid="run-summary-newly-failing"
                        title="@TestList("Newly failing", newlyFailing)" @onclick="() => OnRevealTest.InvokeAsync(newlyFailing[0])">
                    ✗ @newlyFailing.Count newly failing
                </button>
            }
            @if (WatchStrip.ShowOutcomeSummary(run))
            {
                @if (run.Status is "Cancelled" or "Faulted" or "Incomplete")
                {
                    <span class="min-w-0 truncate text-yellow-400" title="@run.StatusReason">@run.Status.ToLowerInvariant()</span>
                }
                else if (run.Failed > 0)
                {
                    <span class="shrink-0 text-red-400" title="No test changed outcome">@run.Failed still failing</span>
                }
                else if (run.TotalTests > 0)
                {
                    <span class="shrink-0 @(run.Passed == run.TotalTests ? "text-green-400" : "")">@WatchStrip.PassedSkippedLabel(run)</span>
                }
                else
                {
                    <span class="shrink-0">no tests ran</span>
                }
            }
        }

        @if (!active && summary.Duration is { } duration)
        {
            <span class="shrink-0 tabular-nums" title="Time from the run starting to finishing, including its build">· @duration</span>
        }
    </span>
}

@code {
    [Parameter] public StateSnapshotNotification? Snapshot { get; set; }

    /// <summary>Selects a test by its project-scoped result key.</summary>
    [Parameter] public EventCallback<TestOutcomeReferenceDto> OnRevealTest { get; set; }

    private TestRunDto? Run => Snapshot?.ActiveRun ?? Snapshot?.LastRun;

    private string? SolutionDirectory => Snapshot?.SolutionPath is { } path && path.LastIndexOfAny(['/', '\\']) is > 0 and var i
        ? path[..i]
        : null;

    private static string TestList(string heading, IReadOnlyList<TestOutcomeReferenceDto> keys) =>
        $"{heading} (click to show the first):{Environment.NewLine}" +
        string.Join(Environment.NewLine, keys.Take(20).Select(t => $"{t.Project}: {WatchStrip.ShortTestName(t.Key)}")) +
        (keys.Count > 20 ? $"{Environment.NewLine}… and {keys.Count - 20} more" : "");
}
