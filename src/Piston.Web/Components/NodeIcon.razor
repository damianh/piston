@using Piston.Web.Models

@* The structural icon of a tree node: project, target framework, namespace, class or pinned. *@
@switch (Structure)
{
    case NodeStructure.Project:
        <svg class="@Class shrink-0 text-violet-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-label="Project">
            <path d="M8 1.5 14 4.5v7L8 14.5 2 11.5v-7z" />
            <path d="M2 4.5 8 7.5 14 4.5M8 7.5v7" />
        </svg>
        break;
    case NodeStructure.Framework:
        <svg class="@Class shrink-0 text-gray-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-label="Target framework">
            <rect x="4" y="4" width="8" height="8" rx="1.5" />
            <path d="M6.5 1.5v2.5M9.5 1.5v2.5M6.5 12v2.5M9.5 12v2.5M1.5 6.5H4M1.5 9.5H4M12 6.5h2.5M12 9.5h2.5" />
        </svg>
        break;
    case NodeStructure.Namespace:
        <svg class="@Class shrink-0 text-sky-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-label="Namespace">
            <path d="M6 2.5c-1.4 0-2 .6-2 2V6c0 1-.5 2-1.5 2 1 0 1.5 1 1.5 2v1.5c0 1.4.6 2 2 2" />
            <path d="M10 2.5c1.4 0 2 .6 2 2V6c0 1 .5 2 1.5 2-1 0-1.5 1-1.5 2v1.5c0 1.4-.6 2-2 2" />
        </svg>
        break;
    case NodeStructure.Class:
        <svg class="@Class shrink-0 text-gray-400" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-label="Class">
            <rect x="2" y="2" width="12" height="12" rx="2.5" />
            <path d="M10.2 6.1a2.6 2.6 0 1 0 0 3.8" />
        </svg>
        break;
    case NodeStructure.Pinned:
        <span class="shrink-0 text-yellow-400" aria-label="Pinned">★</span>
        break;
}

@code {
    [Parameter] public NodeStructure Structure { get; set; }

    /// <summary>Size classes for the icon.</summary>
    [Parameter] public string Class { get; set; } = "w-3.5 h-3.5";
}
