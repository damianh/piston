@using Piston.Protocol.Dtos
@using Piston.Protocol.Messages
@inject EngineClientService Client
@using System.Net.WebSockets
@implements IDisposable

@if (Snapshot?.Phase == PistonPhaseDto.AwaitingTrust)
{
    <div class="fixed inset-0 z-40 flex items-center justify-center bg-gray-950/90 p-4" role="dialog" aria-modal="true" aria-labelledby="trust-title">
        <div class="w-full max-w-xl rounded-lg border border-amber-700 bg-gray-900 p-6 shadow-xl">
            <div class="mb-3 text-2xl text-amber-400" aria-hidden="true">⚠</div>
            <h1 id="trust-title" class="mb-2 text-lg font-semibold text-gray-100">Trust required before builds and tests</h1>
            <p class="mb-4 text-sm leading-6 text-gray-300">
                Piston has not loaded this repository's MSBuild projects, started its file watcher, or run its code.
                Trust is remembered for this clone and applies to its worktrees.
            </p>
            <code class="mb-5 block break-all rounded bg-gray-950 p-3 text-xs text-gray-300">@Snapshot.RepositoryTrustPath</code>
            @if (_error is not null)
            {
                <p class="mb-3 text-sm text-red-400" role="alert">@_error</p>
            }
            <button type="button"
                    class="rounded bg-blue-600 px-4 py-2 font-semibold text-white hover:bg-blue-500 disabled:cursor-not-allowed disabled:opacity-50"
                    disabled="@(_starting || !Client.IsConnected)"
                    @onclick="GrantTrustAsync">
                @(_starting ? "Starting Piston..." : "Trust and start")
            </button>
            <p class="mt-4 text-xs leading-5 text-gray-500">
                This allows Piston to evaluate project files and run builds and tests as your user. It is not a sandbox.
            </p>
        </div>
    </div>
}

@code {
    private StateSnapshotNotification? Snapshot { get; set; }
    private bool _starting;
    private string? _error;

    protected override void OnInitialized()
    {
        Snapshot = Client.CurrentSnapshot;
        Client.StateChanged += OnStateChanged;
    }

    private void OnStateChanged(StateSnapshotNotification snapshot) => InvokeAsync(() =>
    {
        Snapshot = snapshot;
        if (snapshot.Phase != PistonPhaseDto.AwaitingTrust)
        {
            _error = null;
        }
        StateHasChanged();
    });

    private async Task GrantTrustAsync()
    {
        if (_starting) return;
        _starting = true;
        _error = null;
        try
        {
            await Client.GrantTrustAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or WebSocketException)
        {
            _error = ex.Message;
        }
        finally
        {
            _starting = false;
        }
    }

    public void Dispose() => Client.StateChanged -= OnStateChanged;
}
