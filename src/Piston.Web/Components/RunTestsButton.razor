@using Piston.Protocol.Messages
@inject EngineClientService Client

@* Starts a run of the selected node's tests. Keyed by the selection, so an error clears when it changes. *@
<div class="flex flex-col items-end gap-1 shrink-0">
    <button type="button"
            class="flex items-center gap-1.5 px-2 py-1 rounded bg-gray-800 text-gray-200 transition-colors hover:bg-gray-700 focus:outline-none focus-visible:ring-1 focus-visible:ring-blue-500 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-gray-800"
            disabled="@(!Enabled)"
            title="@Tooltip"
            @onclick="RunAsync">
        <svg class="w-3 h-3 text-green-400" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M4.5 2.8v10.4a.6.6 0 0 0 .9.5l8.3-5.2a.6.6 0 0 0 0-1L5.4 2.3a.6.6 0 0 0-.9.5z" />
        </svg>
        <span>@(_starting ? "Starting…" : Label)</span>
    </button>
    @if (_error is not null)
    {
        <div class="text-red-400 text-right max-w-64" role="alert">@_error</div>
    }
</div>

@code {
    /// <summary>The request that runs the tests; the button is disabled without one.</summary>
    [Parameter] public RunTestsCommand? Command { get; set; }

    /// <summary>How many results the run covers, for the label.</summary>
    [Parameter] public int Count { get; set; }

    /// <summary>False while a run is in progress or the daemon is unreachable.</summary>
    [Parameter] public bool CanRun { get; set; }

    /// <summary>Extra context for the tooltip, such as what a run includes beyond the selection.</summary>
    [Parameter] public string? Note { get; set; }

    private bool _starting;
    private string? _error;

    private bool Enabled => Command is not null && CanRun && !_starting;

    private string Label => Count == 1 ? "Run test" : $"Run {Count:N0} tests";

    private string Tooltip =>
        !CanRun ? "Piston is busy; wait for the current run to finish"
        : Command is null ? "These tests are not in a known test project"
        : Note ?? "Build and run these tests";

    private async Task RunAsync()
    {
        if (!Enabled)
        {
            return;
        }

        _starting = true;
        _error = null;
        try
        {
            _error = await Client.RunTestsAsync(Command!);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _starting = false;
        }
    }
}
