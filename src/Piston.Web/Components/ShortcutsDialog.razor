@inject IJSRuntime JS

@if (IsOpen)
{
    <dialog @ref="_modal" aria-labelledby="shortcuts-title"
            class="fixed inset-0 m-0 p-0 w-full h-full max-w-none max-h-none border-0 bg-transparent">
        <div class="flex h-full items-start justify-center pt-[12vh] px-4 bg-black/50 dark:bg-black/60"
             @onclick="CloseAsync" @onkeydown="OnKeyDown" @onkeydown:stopPropagation>
            <div @ref="_dialog" tabindex="-1"
                 class="w-full max-w-sm rounded-lg border border-gray-700 bg-gray-950 text-sm text-gray-100 shadow-[0_8px_24px_rgba(1,4,9,0.35)] outline-none"
                 @onclick:stopPropagation>

                <div class="flex items-center justify-between pl-4 pr-2 h-11 border-b border-gray-800">
                    <h2 id="shortcuts-title" class="font-semibold">Keyboard shortcuts</h2>
                    <button class="p-1.5 rounded text-gray-400 hover:text-gray-100 hover:bg-gray-800"
                            aria-label="Close keyboard shortcuts" title="Close (Esc)" @onclick="CloseAsync">
                        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                            <path d="M4 4l8 8M12 4l-8 8" />
                        </svg>
                    </button>
                </div>

                <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-2 px-4 py-3.5">
                    @foreach (var (keys, action) in Shortcuts)
                    {
                        <dt class="flex items-start gap-1">
                            @foreach (var key in keys)
                            {
                                <kbd class="min-w-6 px-1.5 py-0.5 rounded border border-gray-700 bg-gray-900 text-center font-mono text-xs text-gray-200">@key</kbd>
                            }
                        </dt>
                        <dd class="text-gray-300">@action</dd>
                    }
                </dl>
            </div>
        </div>
    </dialog>
}

@code {
    internal static readonly (string[] Keys, string Action)[] Shortcuts =
    [
        (["R"], "Run the selected test or group"),
        (["[", "]"], "Previous or next failed test"),
        (["1", "2", "3", "4"], "Show or hide failed, passed, skipped or not run"),
        (["G"], "Cycle the grouping"),
        (["E"], "Expand or collapse all"),
        (["S"], "Sort by duration / reverse direction"),
        (["?"], "Show this list"),
    ];

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _modal;
    private ElementReference _dialog;
    private bool _wasOpen;
    private bool _focusPending;

    protected override void OnParametersSet()
    {
        _focusPending |= IsOpen && !_wasOpen;
        _wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && _focusPending)
        {
            _focusPending = false;
            await JS.InvokeVoidAsync("pistonDialog.showModal", _modal);
            await _dialog.FocusAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key is "Escape" or "?" ? CloseAsync() : Task.CompletedTask;
}
