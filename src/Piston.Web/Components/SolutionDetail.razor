@inject EngineClientService Client
@inject ViewState View
@implements IDisposable

<div class="flex flex-col flex-1 overflow-hidden">
    <HeaderBar ActiveTab="@_activeTab" OnTabSelected="SetTab" />

    <div class="flex-1 min-h-0 overflow-hidden">
        @if (_activeTab == DashboardTab.Activity)
        {
            <ActivityTab />
        }
        else if (_activeTab == DashboardTab.Tests)
        {
            <TestsTab KeyboardEvent="@KeyboardEvent" OnTraceTest="TraceTest" />
        }
        else if (_activeTab == DashboardTab.Coverage)
        {
            <CoverageTab OnOpenTest="OpenTest" />
        }
        else if (_activeTab == DashboardTab.Runs)
        {
            <RunsTab OnOpenTest="OpenTest" />
        }
        else if (_activeTab == DashboardTab.Timeline)
        {
            <TimelineTab OnOpenTest="OpenTest" OnOpenRun="OpenRun" />
        }
        else if (_activeTab == DashboardTab.Machine)
        {
            <MachineTab />
        }
    </div>

    <StatusBar />
</div>

@code {
    [Parameter] public KeyboardEventArgs? KeyboardEvent { get; set; }

    private DashboardTab _activeTab = DashboardTab.Tests;

    protected override void OnInitialized()
    {
        Client.ActivityEventReceived += OnActivityEvent;
    }

    private void SetTab(DashboardTab tab) => _activeTab = tab;

    private void OpenTest(TestReference test)
    {
        View.RevealTest(test);
        _activeTab = DashboardTab.Tests;
    }

    private void OpenRun(string runId)
    {
        View.RevealRun(runId);
        _activeTab = DashboardTab.Runs;
    }

    private void TraceTest(TestReference test)
    {
        View.TracedTest = test;
        _activeTab = DashboardTab.Timeline;
    }

    private void OnActivityEvent(ActivityEvent _) { /* keeps badge counts fresh if needed */ }

    public void Dispose()
    {
        Client.ActivityEventReceived -= OnActivityEvent;
    }
}
