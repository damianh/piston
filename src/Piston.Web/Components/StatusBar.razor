@using Piston.Web.Models
@using Piston.Protocol.Dtos

<div class="flex items-center gap-4 px-4 py-1.5 min-h-7 shrink-0 bg-gray-900 border-t border-gray-800 text-xs text-gray-500 select-none">
    <!-- Filter indicator -->
    @if (!string.IsNullOrEmpty(Filter))
    {
        <span class="text-blue-400">filter: @Filter</span>
    }

    <!-- Failure navigation -->
    @if (FailureCount > 0)
    {
        <div class="flex items-center gap-1 ml-auto">
            <span class="text-red-400">@FailureCount failure@(FailureCount == 1 ? "" : "s")</span>
            <button class="hover:text-gray-300" title="Previous failure ([)" @onclick="OnPrevFailure">◀</button>
            <button class="hover:text-gray-300" title="Next failure (])" @onclick="OnNextFailure">▶</button>
        </div>
    }
</div>

@code {
    [Parameter] public string? Filter { get; set; }
    [Parameter] public int FailureCount { get; set; }

    [Parameter] public EventCallback OnPrevFailure { get; set; }
    [Parameter] public EventCallback OnNextFailure { get; set; }
}
