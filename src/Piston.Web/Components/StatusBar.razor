@using Piston.Web.Models
@using Piston.Protocol.Dtos

<div class="flex items-center gap-4 px-4 py-1.5 bg-gray-900 border-t border-gray-800 text-xs text-gray-500 select-none">
    <!-- Grouping mode -->
    <button class="hover:text-gray-300 transition-colors" title="Cycle grouping mode (G)" @onclick="OnCycleGrouping">
        @GroupingLabel(Grouping)
    </button>

    <!-- Status filter toggles -->
    <div class="flex items-center gap-1">
        <button class="@(ShowFailed ? "text-red-400" : "text-gray-700") hover:opacity-80 transition-colors"
                title="Toggle failed (1)" @onclick="OnToggleFailed">✗ F</button>
        <button class="@(ShowPassed ? "text-green-400" : "text-gray-700") hover:opacity-80 transition-colors"
                title="Toggle passed (2)" @onclick="OnTogglePassed">✓ P</button>
        <button class="@(ShowSkipped ? "text-yellow-400" : "text-gray-700") hover:opacity-80 transition-colors"
                title="Toggle skipped (3)" @onclick="OnToggleSkipped">● S</button>
        <button class="@(ShowNotRun ? "text-gray-400" : "text-gray-700") hover:opacity-80 transition-colors"
                title="Toggle not-run (4)" @onclick="OnToggleNotRun">◌ N</button>
    </div>

    <!-- Filter indicator -->
    @if (!string.IsNullOrEmpty(Filter))
    {
        <span class="text-blue-400">filter: @Filter</span>
    }

    <!-- Failure navigation -->
    @if (FailureCount > 0)
    {
        <div class="flex items-center gap-1 ml-auto">
            <span class="text-red-400">@FailureCount failure@(FailureCount == 1 ? "" : "s")</span>
            <button class="hover:text-gray-300" title="Previous failure ([)" @onclick="OnPrevFailure">◀</button>
            <button class="hover:text-gray-300" title="Next failure (])" @onclick="OnNextFailure">▶</button>
        </div>
    }
</div>

@code {
    [Parameter] public GroupingMode Grouping { get; set; }
    [Parameter] public bool ShowFailed { get; set; } = true;
    [Parameter] public bool ShowPassed { get; set; } = true;
    [Parameter] public bool ShowSkipped { get; set; } = true;
    [Parameter] public bool ShowNotRun { get; set; } = true;
    [Parameter] public string? Filter { get; set; }
    [Parameter] public int FailureCount { get; set; }

    [Parameter] public EventCallback OnCycleGrouping { get; set; }
    [Parameter] public EventCallback OnToggleFailed { get; set; }
    [Parameter] public EventCallback OnTogglePassed { get; set; }
    [Parameter] public EventCallback OnToggleSkipped { get; set; }
    [Parameter] public EventCallback OnToggleNotRun { get; set; }
    [Parameter] public EventCallback OnPrevFailure { get; set; }
    [Parameter] public EventCallback OnNextFailure { get; set; }

    private static string GroupingLabel(GroupingMode mode) =>
        mode switch
        {
            GroupingMode.ProjectNamespaceClass => "group: project/ns/class",
            GroupingMode.ByStatus              => "group: by status",
            GroupingMode.Flat                  => "group: flat",
            _                                  => "group: ?",
        };
}
