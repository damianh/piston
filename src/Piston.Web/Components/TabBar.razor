@using Piston.Web.Components

<div class="flex self-stretch" role="tablist">
    @foreach (var tab in new[] { DashboardTab.Tests, DashboardTab.Activity })
    {
        var tabName = tab.ToString();
        var isActive = tab == ActiveTab;
        <button class="px-3 border-b-2 @(isActive ? "border-coral text-gray-100 font-semibold" : "border-transparent text-gray-400 hover:text-gray-100 hover:border-gray-700")"
                role="tab" aria-selected="@(isActive ? "true" : "false")"
                @onclick="() => OnTabSelected.InvokeAsync(tab)">
            @tabName
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public DashboardTab ActiveTab { get; set; }
    [Parameter, EditorRequired] public EventCallback<DashboardTab> OnTabSelected { get; set; }
}
