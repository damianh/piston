@using Piston.Web.Components

<div class="flex border-b border-gray-800 bg-gray-950 text-xs shrink-0">
    @foreach (var tab in Enum.GetValues<DashboardTab>())
    {
        var tabName = tab.ToString();
        var isActive = tab == ActiveTab;
        <button class="px-4 py-2 border-b-2 transition-colors @(isActive ? "border-blue-500 text-blue-400" : "border-transparent text-gray-500 hover:text-gray-300 hover:border-gray-600")"
                @onclick="() => OnTabSelected.InvokeAsync(tab)">
            @tabName
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public DashboardTab ActiveTab { get; set; }
    [Parameter, EditorRequired] public EventCallback<DashboardTab> OnTabSelected { get; set; }
}
