@using Piston.Protocol.Dtos
@inject EngineClientService Client
@inject ViewState _viewState
@inject IJSRuntime JS

@if (Test is null)
{
    <div class="flex items-center justify-center h-full text-gray-600 text-xs">
        Select a test to view details
    </div>
}
else
{
    var statusColor = Test.Status switch
    {
        TestStatusDto.Passed  => "text-green-400",
        TestStatusDto.Failed  => "text-red-400",
        TestStatusDto.Skipped => "text-yellow-400",
        TestStatusDto.Running => "text-cyan-400",
        _                     => "text-gray-500",
    };
    var statusIcon = Test.Status switch
    {
        TestStatusDto.Passed  => "✓",
        TestStatusDto.Failed  => "✗",
        TestStatusDto.Skipped => "●",
        TestStatusDto.Running => "⟳",
        _                     => "◌",
    };

    var (title, subtitle) = TestTreeBuilder.DetailNames(Test);

    <div class="flex flex-col h-full overflow-y-auto p-4 gap-4 text-xs">
        <!-- Test name + status -->
        <div>
            <div class="flex items-center gap-2 mb-1">
                <span class="@statusColor text-base">@statusIcon</span>
                <span class="text-gray-200 font-semibold break-all" title="@Test.FullyQualifiedName">@title</span>
            </div>
            @if (subtitle is not null)
            {
                <div class="text-gray-500 break-all">@subtitle</div>
            }
            @if (Test.TargetFramework is { } framework)
            {
                <div class="text-gray-500 mt-1">Framework: <span class="font-mono">@framework</span></div>
            }
            @if (Test.DurationMs > 0)
            {
                <div class="text-gray-500 mt-1">Duration: @FormatDuration(Test.DurationMs)</div>
            }
        </div>

        <!-- Error message -->
        @if (!string.IsNullOrEmpty(Test.ErrorMessage))
        {
            <div>
                <div class="text-red-400 font-semibold mb-1">Error</div>
                <pre class="bg-gray-900 border border-gray-800 rounded p-3 text-red-300 text-xs overflow-x-auto whitespace-pre-wrap break-all">@Test.ErrorMessage</pre>
            </div>
        }

        <!-- Stack trace -->
        @if (!string.IsNullOrEmpty(Test.StackTrace))
        {
            <div>
                <div class="text-gray-400 font-semibold mb-1">Stack Trace</div>
                <pre class="bg-gray-900 border border-gray-800 rounded p-3 text-gray-400 text-xs overflow-x-auto whitespace-pre-wrap break-all">@Test.StackTrace</pre>
            </div>
        }

        <!-- Output -->
        <div>
            <div class="flex items-center justify-between mb-1">
                <div class="text-gray-400 font-semibold">Output</div>
                @if (!string.IsNullOrEmpty(Test.Output))
                {
                    <button type="button" class="text-gray-500 hover:text-gray-300 focus-visible:text-gray-300 focus:outline-none"
                            @onclick="() => CopyAsync(Test.Output)">Copy</button>
                }
            </div>
            @if (string.IsNullOrEmpty(Test.Output))
            {
                <div class="text-gray-600">No output captured for this result.</div>
            }
            else
            {
                <pre class="bg-gray-900 border border-gray-800 rounded p-3 text-gray-400 text-xs max-h-64 overflow-auto whitespace-pre-wrap break-all">@Test.Output</pre>
            }
        </div>

        <!-- Run log -->
        <div>
            <div class="flex items-center justify-between mb-1">
                <button type="button" class="flex items-center gap-1 text-gray-400 font-semibold hover:text-gray-200 focus-visible:text-gray-200 focus:outline-none"
                        aria-expanded="@(_viewState.ShowRunLog ? "true" : "false")"
                        aria-controls="test-run-log"
                        @onclick="ToggleRunLogAsync">
                    <svg class="w-3 h-3 shrink-0 @(_viewState.ShowRunLog ? "rotate-90" : "")" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M6.22 3.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L9.94 8 6.22 4.28a.75.75 0 0 1 0-1.06Z" />
                    </svg>
                    Run log
                </button>
                @if (_viewState.ShowRunLog && _log is { Entries.Count: > 0 })
                {
                    <button type="button" class="text-gray-500 hover:text-gray-300 focus-visible:text-gray-300 focus:outline-none"
                            @onclick="() => CopyAsync(FormatLog(_log))">Copy</button>
                }
            </div>
            @if (_viewState.ShowRunLog)
            {
                <div id="test-run-log">
                    @if (_logLoading)
                    {
                        <div class="text-gray-600">Loading…</div>
                    }
                    else if (_log is null)
                    {
                        <div class="text-gray-600">No run log for this result. Piston keeps the log of each project's latest run while the daemon is running.</div>
                    }
                    else
                    {
                        <div class="text-gray-500 mb-1">
                            @string.Join(" · ", RunLogSummary(_log))
                        </div>
                        <div class="bg-gray-900 border border-gray-800 rounded p-3 font-mono text-xs max-h-96 overflow-auto">
                            @foreach (var entry in _log.Entries)
                            {
                                <div class="flex gap-2 whitespace-pre-wrap break-all @EntryColor(entry.Category)">
                                    <span class="text-gray-600 shrink-0">@entry.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</span>
                                    <span class="min-w-0"><span class="text-gray-500">@entry.Category</span> @entry.Message</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public TestResultDto? Test { get; set; }

    /// <summary>The run that produced <see cref="Test"/>'s result; a change means its log may have changed.</summary>
    [Parameter] public string? RunId { get; set; }

    private ExecutionLogDto? _log;
    private bool _logLoading;
    private string? _logFor;

    protected override Task OnParametersSetAsync() =>
        _viewState.ShowRunLog ? LoadRunLogAsync() : Task.CompletedTask;

    private async Task ToggleRunLogAsync()
    {
        _viewState.ShowRunLog = !_viewState.ShowRunLog;
        if (_viewState.ShowRunLog)
        {
            await LoadRunLogAsync();
        }
    }

    private async Task LoadRunLogAsync()
    {
        if (Test is null)
        {
            return;
        }

        var request = $"{Test.Key}|{RunId}";
        if (request == _logFor)
        {
            return;
        }

        _logFor = request;
        _log = null;
        _logLoading = true;
        ExecutionLogDto? log = null;
        try
        {
            log = await Client.GetRunLogAsync(Test.FullyQualifiedName, Test.TargetFramework);
        }
        catch
        {
            // Unreachable daemon: shown as no log.
        }

        // A newer selection may have started its own request meanwhile.
        if (_logFor == request)
        {
            _log = log;
            _logLoading = false;
        }
    }

    private static IEnumerable<string> RunLogSummary(ExecutionLogDto log)
    {
        yield return Path.GetFileNameWithoutExtension(log.ProjectPath);
        if (log.Runner is { } runner)
        {
            yield return runner;
        }

        if (log.ExitCode is { } exitCode)
        {
            yield return $"exit code {exitCode}";
        }

        if (log.CompletedAt is { } completed)
        {
            yield return FormatDuration((completed - log.StartedAt).TotalMilliseconds);
        }

        yield return $"started {log.StartedAt.ToLocalTime():HH:mm:ss}";
    }

    private static string EntryColor(string category) =>
        category.EndsWith("stderr", StringComparison.OrdinalIgnoreCase) ? "text-amber-300"
        : category.EndsWith("stdout", StringComparison.OrdinalIgnoreCase) ? "text-gray-400"
        : "text-gray-300";

    private static string FormatLog(ExecutionLogDto log) =>
        string.Join(Environment.NewLine, log.Entries.Select(e =>
            $"{e.Timestamp.ToLocalTime():HH:mm:ss.fff} {e.Category} {e.Message}"));

    private async Task CopyAsync(string? text)
    {
        if (string.IsNullOrEmpty(text))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (JSException)
        {
            // Clipboard access denied (e.g. insecure context); nothing to do.
        }
    }

    private static string FormatDuration(double ms) =>
        ms < 1000 ? $"{(int)ms}ms" : $"{ms / 1000.0:F1}s";
}
