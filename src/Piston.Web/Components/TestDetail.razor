@using Piston.Protocol.Dtos
@using Piston.Protocol.Messages
@using Piston.Web.Models
@inject IJSRuntime JS

@if (Test is null)
{
    <div class="flex items-center justify-center h-full text-gray-600 text-xs">
        Select a test to view details
    </div>
}
else
{
    var statusColor = Test.Status switch
    {
        TestStatusDto.Passed  => "text-green-400",
        TestStatusDto.Failed  => "text-red-400",
        TestStatusDto.Skipped => "text-yellow-400",
        TestStatusDto.Running => "text-cyan-400",
        _                     => "text-gray-500",
    };
    var statusIcon = Test.Status switch
    {
        TestStatusDto.Passed  => "✓",
        TestStatusDto.Failed  => "✗",
        TestStatusDto.Skipped => "●",
        TestStatusDto.Running => "⟳",
        _                     => "◌",
    };

    var (title, subtitle) = TestTreeBuilder.DetailNames(Test);

    <div class="flex flex-col h-full overflow-y-auto p-4 gap-4 text-xs">
        <!-- Test name + status -->
        <div>
            <div class="flex items-start gap-3 mb-1">
                <div class="flex items-center gap-2 min-w-0 flex-1 pt-0.5">
                    <span class="@statusColor text-base">@statusIcon</span>
                    <span class="text-gray-200 font-semibold break-all" title="@Test.FullyQualifiedName">@title</span>
                </div>
                <RunTestsButton Command="@RunCommand" Count="1" CanRun="@CanRun" Note="@RunNote" />
            </div>
            @if (subtitle is not null)
            {
                <div class="text-gray-500 break-all">@subtitle</div>
            }
            @if (Project is not null)
            {
                <div class="text-gray-500 mt-1">
                    Project:
                    <button type="button"
                            class="text-gray-300 underline decoration-gray-600 underline-offset-2 hover:decoration-gray-300 focus-visible:decoration-gray-300 focus:outline-none"
                            title="Show project details and its run log"
                            @onclick="() => OnShowProject.InvokeAsync(Project)">                            @(ProjectLabel ?? Project)</button>
                </div>
            }
            @if (Test.TargetFramework is { } framework)
            {
                <div class="text-gray-500 mt-1">Framework: <span class="font-mono">@framework</span></div>
            }
            @if (TestNode.HasDuration(Test))
            {
                <div class="text-gray-500 mt-1">Duration: @FormatDuration(Test.DurationMs)</div>
            }
        </div>

        <HistoryStrip TestKey="@Test.Key" Project="@Project" />

        @if (Test.Status == TestStatusDto.Failed && Project is not null && OnTraceTest.HasDelegate)
        {
            <div>
                <button type="button"
                        class="text-gray-300 underline decoration-gray-600 underline-offset-2 hover:decoration-gray-300 focus-visible:decoration-gray-300 focus:outline-none"
                        title="Show the run that started this failure and the edit before it"
                        @onclick="() => OnTraceTest.InvokeAsync(new TestReference(Project, Test.Key))">Trace in timeline</button>
            </div>
        }

        <!-- Earlier attempts when the test was retried within the run -->
        @if (Test.Attempts is { Count: > 0 } attempts)
        {
            <div>
                <div class="text-gray-400 font-semibold mb-1">Retries <span class="font-normal text-yellow-400">@TestRetries.Describe(Test)</span></div>
                <ol class="flex flex-col gap-1">
                    @for (var i = 0; i < attempts.Count; i++)
                    {
                        var attempt = attempts[i];
                        <li>
                            <div class="text-gray-400">Attempt @(i + 1): <span class="@(attempt.Status == TestStatusDto.Failed ? "text-red-400" : "text-gray-300")">@attempt.Status</span> in @FormatDuration(attempt.DurationMs)</div>
                            @if (!string.IsNullOrEmpty(attempt.ErrorMessage))
                            {
                                <pre class="bg-gray-900 border border-gray-800 rounded p-2 text-red-300 text-xs max-h-32 overflow-auto whitespace-pre-wrap break-all">@attempt.ErrorMessage</pre>
                            }
                        </li>
                    }
                </ol>
            </div>
        }

        <!-- Why the last run selected it -->
        @if (SelectionReasons is { Count: > 0 } reasons)
        {
            <div>
                <div class="text-gray-400 font-semibold mb-1">Why it ran</div>
                <ul class="flex flex-col gap-1">
                    @foreach (var reason in reasons)
                    {
                        <li class="flex items-start gap-2">
                            <GranularityBadge Granularity="@reason.Granularity" />
                            <span class="text-gray-300 break-all" title="@reason.FilePath">@DescribeReason(reason)</span>
                        </li>
                    }
                </ul>
            </div>
        }

        <!-- Error message -->
        @if (!string.IsNullOrEmpty(Test.ErrorMessage))
        {
            <div>
                <div class="text-red-400 font-semibold mb-1">Error</div>
                <pre class="bg-gray-900 border border-gray-800 rounded p-3 text-red-300 text-xs overflow-x-auto whitespace-pre-wrap break-all">@Test.ErrorMessage</pre>
            </div>
        }

        <!-- Expected vs actual, with the differing part highlighted -->
        @if (AssertionDiff.Parse(Test.ErrorMessage) is { } diff)
        {
            var (prefix, expectedMiddle, actualMiddle, suffix) = diff.Split();
            <div>
                <div class="text-gray-400 font-semibold mb-1">Difference</div>
                @if (diff.Summary.Length > 0)
                {
                    <div class="text-gray-500 mb-1 whitespace-pre-wrap">@diff.Summary</div>
                }
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <div>
                        <div class="text-gray-500 mb-0.5">Expected</div>
                        <pre class="bg-gray-900 border border-gray-800 rounded p-2 text-gray-300 text-xs overflow-x-auto whitespace-pre-wrap break-all">@prefix<mark class="bg-green-900/60 text-green-300 rounded-sm">@expectedMiddle</mark>@suffix</pre>
                    </div>
                    <div>
                        <div class="text-gray-500 mb-0.5">Actual</div>
                        <pre class="bg-gray-900 border border-gray-800 rounded p-2 text-gray-300 text-xs overflow-x-auto whitespace-pre-wrap break-all">@prefix<mark class="bg-red-900/60 text-red-300 rounded-sm">@actualMiddle</mark>@suffix</pre>
                    </div>
                </div>
            </div>
        }

        <!-- Stack trace, with the source of the selected frame: by default the failing line of the solution's code -->
        @if (Frames.Count > 0)
        {
            <div>
                <div class="text-gray-400 font-semibold mb-1">Stack Trace</div>
                @if (_sourceFrame is { } shown)
                {
                    <div class="mb-2">
                        <SourceExcerpt FilePath="@(shown.FilePath!)" Line="@(shown.Line!.Value)" SolutionDirectory="@SolutionDirectory" />
                    </div>
                }
                <div class="bg-gray-900 border border-gray-800 rounded p-3 text-gray-400 text-xs font-mono overflow-x-auto whitespace-pre-wrap break-all">
                    @foreach (var frame in Frames)
                    {
                        @if (frame.HasSource && StackTraceParser.IsInSolution(frame.FilePath!, SolutionDirectory))
                        {
                            var current = frame == _sourceFrame;
                            <button type="button" class="block w-full text-left whitespace-pre-wrap break-all rounded-sm focus:outline-none focus-visible:ring-1 focus-visible:ring-blue-500 @(current ? "text-gray-200 bg-gray-800" : "text-gray-300 hover:text-gray-100 hover:bg-gray-800")"
                                    title="Show this line of source" aria-pressed="@(current ? "true" : "false")"
                                    @onclick="() => _sourceFrame = frame">@frame.Text</button>
                        }
                        else
                        {
                            <span class="block">@frame.Text</span>
                        }
                    }
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Test.Output))
        {
            <div>
                <div class="flex items-center justify-between mb-1">
                    <div class="text-gray-400 font-semibold">Standard output</div>
                    <button type="button" class="text-gray-500 hover:text-gray-300 focus-visible:text-gray-300 focus:outline-none"
                            @onclick="() => CopyAsync(Test.Output)">Copy</button>
                </div>
                <pre class="bg-gray-900 border border-gray-800 rounded p-3 text-gray-400 text-xs max-h-64 overflow-auto whitespace-pre-wrap break-all">@Test.Output</pre>
            </div>
        }
        @if (!string.IsNullOrEmpty(Test.ErrorOutput))
        {
            <div>
                <div class="flex items-center justify-between mb-1">
                    <div class="text-gray-400 font-semibold">Error output</div>
                    <button type="button" class="text-gray-500 hover:text-gray-300 focus-visible:text-gray-300 focus:outline-none"
                            @onclick="() => CopyAsync(Test.ErrorOutput)">Copy</button>
                </div>
                <pre class="bg-gray-900 border border-gray-800 rounded p-3 text-gray-400 text-xs max-h-64 overflow-auto whitespace-pre-wrap break-all">@Test.ErrorOutput</pre>
            </div>
        }
        @if (Test.Attachments.Count > 0)
        {
            <div>
                <div class="text-gray-400 font-semibold mb-1">Attachments</div>
                <ul class="flex flex-col gap-2">
                    @foreach (var attachment in Test.Attachments)
                    {
                        <li class="bg-gray-900 border border-gray-800 rounded p-2">
                            @if (attachment.Retained && attachment.Url is { } url)
                            {
                                <a class="text-blue-300 underline hover:text-blue-200 break-all" href="@url" target="_blank" rel="noopener noreferrer">
                                    @(attachment.DisplayName ?? attachment.FileName ?? "Attachment")
                                </a>
                                @if (attachment.SizeBytes is { } size)
                                {
                                    <span class="text-gray-500 ml-2">@FormatBytes(size)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(attachment.Description))
                                {
                                    <div class="text-gray-500 mt-1">@attachment.Description</div>
                                }
                                @if (IsPreviewableImage(attachment.FileName))
                                {
                                    <a class="block mt-2" href="@url" target="_blank" rel="noopener noreferrer">
                                        <img class="max-h-48 max-w-full object-contain" src="@url"
                                             alt="@(attachment.DisplayName ?? attachment.FileName ?? "Test attachment")" loading="lazy" />
                                    </a>
                                }
                            }
                            else
                            {
                                <div class="text-gray-300 break-all">@(attachment.DisplayName ?? attachment.FileName ?? "Attachment")</div>
                                <div class="text-amber-400 mt-1">Not retained: @(attachment.NotRetainedReason ?? "file is unavailable")</div>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
        @if (string.IsNullOrEmpty(Test.Output) && string.IsNullOrEmpty(Test.ErrorOutput) && Test.Attachments.Count == 0)
        {
            <div>
            <div class="flex items-center justify-between mb-1">
                    <div class="text-gray-400 font-semibold">Output</div>
            </div>
                <div class="text-gray-600">No output captured for this result.</div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public TestResultDto? Test { get; set; }

    /// <summary>The project that produced <see cref="Test"/>'s result.</summary>
    [Parameter] public string? Project { get; set; }
    [Parameter] public string? ProjectLabel { get; set; }

    /// <summary>Shows a project's details, including its run log.</summary>
    [Parameter] public EventCallback<string> OnShowProject { get; set; }

    /// <summary>Follows the test in the Timeline tab.</summary>
    [Parameter] public EventCallback<TestReference> OnTraceTest { get; set; }

    /// <summary>False while a run is in progress or the daemon is unreachable.</summary>
    [Parameter] public bool CanRun { get; set; }

    /// <summary>Why the last run selected the test, when the impact map narrowed it by changed lines.</summary>
    [Parameter] public IReadOnlyList<TestSelectionReasonDto>? SelectionReasons { get; set; }

    /// <summary>The watched solution, for showing changed files relative to it.</summary>
    [Parameter] public string? SolutionPath { get; set; }

    private string DescribeReason(TestSelectionReasonDto reason)
    {
        var file = Path.GetDirectoryName(SolutionPath) is { Length: > 0 } root
            ? Path.GetRelativePath(root, reason.FilePath)
            : Path.GetFileName(reason.FilePath);
        var who = GranularityBadge.Executor(reason.Granularity);
        var selection = reason.ExecutedLines is { } executed
            ? $"{file}: {Lines(reason.ChangedLines)} changed, overlapping {Lines(executed)} that {who} executed"
            : $"{file}: {Lines(reason.ChangedLines)} changed outside every line {who} executed, so every test that executed the file ran";
        return reason.Branches is { Count: > 0 } branches
            ? $"{selection}; {string.Join(", ", branches.Select(b => $"{b.Covered} of {b.Total} branch outcomes on {Lines(b.Line.ToString())}"))}"
            : selection;
    }

    private static string Lines(string range) => range.Contains('-', StringComparison.Ordinal) ? $"lines {range}" : $"line {range}";

    private string? _framesFor;
    private IReadOnlyList<StackFrameLine> _frames = [];
    private StackFrameLine? _sourceFrame;

    private string? SolutionDirectory =>
        SolutionPath is { } path && path.LastIndexOfAny(['/', '\\']) is var slash and > 0 ? path[..slash] : null;

    private IReadOnlyList<StackFrameLine> Frames => _frames;

    protected override void OnParametersSet()
    {
        var trace = Test?.StackTrace;
        if (trace == _framesFor)
        {
            return;
        }

        _framesFor = trace;
        _frames = StackTraceParser.Parse(trace);
        _sourceFrame = StackTraceParser.FirstInSolution(_frames, SolutionDirectory);
    }

    private RunTestsCommand? RunCommand =>
        Test is null || Project is null
            ? null
            : new RunTestsCommand([Project], [Test.FullyQualifiedName]);

    // A filter selects by name, so every case of a theory and every target framework runs.
    private string? RunNote =>
        Test is null ? null
        : Test.TargetFramework is not null ? "Build and run this test on every framework the project targets"
        : TestTreeBuilder.NameHead(Test.FullyQualifiedName) != Test.FullyQualifiedName ? "Build and run every case of this test"
        : "Build and run this test";

    private async Task CopyAsync(string? text)
    {
        if (string.IsNullOrEmpty(text))
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (JSException)
        {
            // Clipboard access denied (e.g. insecure context); nothing to do.
        }
    }

    private static string FormatDuration(double ms) => TestNode.FormatDuration(ms);

    private static string FormatBytes(long bytes) =>
        bytes >= 1024 * 1024 ? $"{bytes / (1024d * 1024):F1} MiB"
        : bytes >= 1024 ? $"{bytes / 1024d:F1} KiB"
        : $"{bytes} B";

    private static bool IsPreviewableImage(string? fileName) =>
        fileName is not null && Path.GetExtension(fileName).ToLowerInvariant() is ".png" or ".jpg" or ".jpeg" or ".gif" or ".webp";
}
