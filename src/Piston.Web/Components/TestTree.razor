@using Piston.Web.Models
@using Piston.Protocol.Dtos

<div class="flex flex-col h-full overflow-hidden">
    @if (Nodes.Count == 0)
    {
        <div class="flex items-center justify-center h-full text-gray-600 text-xs">
            No tests
        </div>
    }
    else
    {
        <div class="overflow-y-auto flex-1">
            @foreach (var node in Nodes)
            {
                <TestTreeNode Node="node"
                              Depth="0"
                              SelectedKey="@SelectedKey"
                              SelectedProject="@SelectedProject"
                              PinnedFqns="@PinnedFqns"
                              OnSelectTest="@OnSelectTest"
                              OnSelectProject="@OnSelectProject"
                              OnTogglePin="@OnTogglePin"
                              OnExpansionChanged="@OnExpansionChanged" />
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<TestNode> Nodes { get; set; } = [];
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public string? SelectedProject { get; set; }
    [Parameter] public HashSet<string> PinnedFqns { get; set; } = [];
    [Parameter] public EventCallback<TestResultDto> OnSelectTest { get; set; }
    [Parameter] public EventCallback<string> OnSelectProject { get; set; }
    [Parameter] public EventCallback<string> OnTogglePin { get; set; }
    [Parameter] public Action<TestNode>? OnExpansionChanged { get; set; }
}
