@using Piston.Web.Models
@using Piston.Protocol.Dtos
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="flex flex-col h-full overflow-hidden">
    <!-- Only the rows in view are rendered, so large suites stay responsive. The window follows the scroll
         position alone, so updates during a run patch the visible rows in place instead of shifting or blanking them. -->
    <div class="overflow-y-auto flex-1" style="overflow-anchor: none" @ref="_scroller">
        @if (Nodes.Count == 0)
        {
            <div class="flex items-center justify-center h-full text-gray-600 text-xs">
                No tests
            </div>
        }
        else
        {
            var (first, count) = TreeRow.Window(_rows.Count, _scrollTop, _viewportHeight);
            <div style="box-sizing: border-box; height: @(_rows.Count * TreeRow.Height)px; padding-top: @(first * TreeRow.Height)px">
                @for (var i = first; i < first + count; i++)
                {
                    var row = _rows[i];
                    <TestTreeNode @key="row.Key"
                                  Node="row.Node"
                                  Depth="row.Depth"
                                  RowKey="@row.Key"
                                  Selection="@Selection"
                                  SelectedKey="@SelectedKey"
                                  SelectedProject="@SelectedProject"
                                  SelectedNodeKey="@SelectedNodeKey"
                                  PinnedFqns="@PinnedFqns"
                                  OnRowClick="@OnRowClick"
                                  OnRowMenu="@OnRowMenu"
                                  OnTogglePin="@OnTogglePin"
                                  OnExpansionChanged="@ExpansionChanged" />
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public List<TestNode> Nodes { get; set; } = [];
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public string? SelectedProject { get; set; }
    [Parameter] public string? SelectedNodeKey { get; set; }
    [Parameter] public HashSet<string> PinnedFqns { get; set; } = [];
    [Parameter] public TreeSelection? Selection { get; set; }
    [Parameter] public EventCallback<TreeRowClick> OnRowClick { get; set; }
    [Parameter] public EventCallback<TreeRowMenu> OnRowMenu { get; set; }
    [Parameter] public EventCallback<string> OnTogglePin { get; set; }
    [Parameter] public Action<TestNode>? OnExpansionChanged { get; set; }

    /// <summary>The visible rows, in order; a Shift+click selects a range of them.</summary>
    public IReadOnlyList<TreeRow> Rows => _rows;

    private ElementReference _scroller;
    private List<TreeRow> _rows = [];
    private DotNetObjectReference<TestTree>? _selfRef;
    private double _scrollTop;

    // Until the browser reports the real height, render enough rows for a tall viewport.
    private double _viewportHeight = 1200;

    protected override void OnParametersSet() => _rows = TreeRow.Flatten(Nodes);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _selfRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("pistonScroll.observe", _scroller, _selfRef);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>Called by the browser when the list scrolls or resizes; re-renders only when the window changes.</summary>
    [JSInvokable]
    public void SetViewport(double scrollTop, double viewportHeight)
    {
        var before = TreeRow.Window(_rows.Count, _scrollTop, _viewportHeight);
        _scrollTop = scrollTop;
        _viewportHeight = viewportHeight;
        if (TreeRow.Window(_rows.Count, _scrollTop, _viewportHeight) != before)
        {
            StateHasChanged();
        }
    }

    private void ExpansionChanged(TestNode node)
    {
        OnExpansionChanged?.Invoke(node);
        _rows = TreeRow.Flatten(Nodes);
        StateHasChanged();
    }

    /// <summary>Scrolls the selected row into view, including one outside the rendered window.</summary>
    public async Task RevealSelectedAsync()
    {
        _rows = TreeRow.Flatten(Nodes);
        var index = TreeRow.IndexOfSelected(_rows, SelectedKey, SelectedNodeKey, SelectedProject);
        try
        {
            await JS.InvokeVoidAsync("pistonScroll.revealRow", _scroller, index, TreeRow.Height);
        }
        catch (JSDisconnectedException)
        {
        }
    }

    /// <summary>Viewport coordinates just below the selected row, scrolling it into view; null when it is not rendered.</summary>
    public async Task<double[]?> SelectedRowPointAsync()
    {
        try
        {
            return await JS.InvokeAsync<double[]?>("pistonTreeMenu.selectedRowPoint", _scroller);
        }
        catch (JSDisconnectedException)
        {
            return null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("pistonScroll.unobserve", _scroller);
        }
        catch (JSDisconnectedException)
        {
        }

        _selfRef?.Dispose();
    }
}
