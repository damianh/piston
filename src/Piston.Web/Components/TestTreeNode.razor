@using Piston.Web.Models
@using Piston.Protocol.Dtos
@inject ViewState View

@{
    var indent = Depth * 16;
    var isTest = Node.Kind == TestNodeKind.Test;
    var isSelected = isTest
        ? Node.Test?.Key == SelectedKey && (SelectedProject is null || Node.Project == SelectedProject)
        : Node.ExpansionKey is { } key && key == SelectedNodeKey;
    var isPinned = isTest && Node.Test is not null && PinnedFqns.Contains(Node.Test.FullyQualifiedName);
    NodeCounts? counts = isTest ? null : Node.Counts();
}

<!-- Node row: a click shows the node's details; the chevron or a double-click expands or collapses it -->
<div class="relative flex items-center gap-1 px-2 h-5 cursor-pointer hover:bg-gray-800 @(isSelected ? "bg-gray-700" : "") @(Node.IsStale ? "opacity-50" : "")"
     style="padding-left: @(indent + 8)px"
     data-selected="@(isSelected ? "true" : null)"
     title="@(isTest ? null : "Show details · double-click to expand or collapse")"
     @onclick="HandleClick"
     @ondblclick="HandleDoubleClick">

    @if (Node.Children.Count > 0)
    {
        <button type="button"
                class="shrink-0 text-gray-600 hover:text-gray-300 focus-visible:text-gray-300 focus:outline-none w-3 text-center text-xs select-none"
                aria-label="@(Node.IsExpanded ? "Collapse" : "Expand") @Node.Label"
                aria-expanded="@(Node.IsExpanded ? "true" : "false")"
                @onclick="ToggleExpanded"
                @onclick:stopPropagation="true"
                @ondblclick:stopPropagation="true">@(Node.IsExpanded ? "▾" : "▸")</button>
    }
    else
    {
        <span class="w-3 shrink-0"></span>
    }

    <!-- Status icon -->
    <span class="@StatusColor(Node) w-4 shrink-0 text-center">@StatusIcon(Node)</span>

    <!-- Structural icon: project / framework / namespace / class -->
    @if (Node.Structure is not (NodeStructure.Status or NodeStructure.Pinned))
    {
        <NodeIcon Structure="@Node.Structure" />
    }

    <!-- Label: sized to its text so the counts sit just after it; truncates when the row is too narrow -->
    <span class="min-w-0 truncate text-xs @(Node.Kind == TestNodeKind.Test ? "text-gray-200" : "text-gray-300 font-medium")"
          title="@(Node.Test?.FullyQualifiedName)">
        @if (isPinned)
        {
            <span class="text-yellow-400 mr-1">★</span>
        }
        @Node.Label
    </span>

    <FrameworkBadge Framework="@Node.Framework" />

    @if (isTest && Node.Test is { } marked)
    {
        @if (TestTreeBuilder.IsNewFailure(marked, Node.Project, View))
        {
            <span class="shrink-0 px-1 rounded text-[10px] bg-red-500/15 text-red-400" title="New failure: its previous result passed">new</span>
        }
        @if (TestTreeBuilder.IsFlaky(marked, Node.Project, View))
        {
            <span class="shrink-0 px-1 rounded text-[10px] bg-yellow-500/15 text-yellow-400"
                  title="@TestRetries.FlakyTitle(View.GetTestMark(Node.Project, marked.Key)?.Flakiness)">flaky</span>
        }
        @if (TestRetries.Describe(marked) is { } retried)
        {
            <span class="shrink-0 px-1 rounded text-[10px] bg-yellow-500/15 text-yellow-400" title="@retried">retried</span>
        }
    }

    <!-- Result counts for group nodes: total, passed, failed (status rows already count in their label) -->
    @if (counts is { Total: > 0 } c && Node.Structure != NodeStructure.Status)
    {
        <span class="flex shrink-0 items-center gap-1.5 ml-2 text-xs tabular-nums" title="@c.Description">
            <span class="sr-only">@c.Description</span>
            <span class="text-gray-500" aria-hidden="true">@c.Total.ToString("N0")</span>
            @if (c.Passed > 0)
            {
                <span class="text-green-400" aria-hidden="true">✓@c.Passed.ToString("N0")</span>
            }
            @if (c.Failed > 0)
            {
                <span class="text-red-400" aria-hidden="true">✗@c.Failed.ToString("N0")</span>
            }
        </span>
    }

    <span class="flex-1"></span>

    <!-- Duration column: a test's own, or the summed test time under a group -->
    <span class="w-14 shrink-0 text-right text-yellow-600 text-xs tabular-nums">
        @if (Node.Kind == TestNodeKind.Test && Node.Test is { } test && TestNode.HasDuration(test))
        {
            @TestNode.FormatDuration(test.DurationMs)
        }
        else if (counts is { } d && d.Passed + d.Failed > 0)
        {
            <span title="@d.DurationDescription">
                <span class="sr-only">@d.DurationDescription</span>
                <span aria-hidden="true">@TestNode.FormatDuration(d.DurationMs)</span>
            </span>
        }
    </span>

    <!-- Pin button (visible on hover for test nodes); group rows keep its width so the duration column lines up -->
    @if (Node.Kind == TestNodeKind.Test && Node.Test is not null)
    {
        <button class="w-4 shrink-0 text-center text-gray-700 hover:text-yellow-400 ml-1 text-xs opacity-0 group-hover:opacity-100 transition-opacity"
                title="@(isPinned ? "Unpin" : "Pin")"
                @onclick:stopPropagation="true"
                @onclick="() => OnTogglePin.InvokeAsync(Node.Test.FullyQualifiedName)">
            @(isPinned ? "★" : "☆")
        </button>
    }
    else
    {
        <span class="w-4 shrink-0 ml-1" aria-hidden="true"></span>
    }
</div>

@code {
    [Parameter] public required TestNode Node { get; set; }
    [Parameter] public int Depth { get; set; }
    [Parameter] public string? SelectedKey { get; set; }
    [Parameter] public string? SelectedProject { get; set; }

    /// <summary>The expansion key of the selected non-test node.</summary>
    [Parameter] public string? SelectedNodeKey { get; set; }
    [Parameter] public HashSet<string> PinnedFqns { get; set; } = [];
    [Parameter] public EventCallback<TestResultDto> OnSelectTest { get; set; }

    /// <summary>Selects a non-test node by its expansion key.</summary>
    [Parameter] public EventCallback<string> OnSelectNode { get; set; }
    [Parameter] public EventCallback<string> OnTogglePin { get; set; }
    [Parameter] public Action<TestNode>? OnExpansionChanged { get; set; }

    private void HandleClick()
    {
        if (Node.Kind == TestNodeKind.Test && Node.Test is not null)
        {
            OnSelectTest.InvokeAsync(Node.Test);
        }
        else if (Node.ExpansionKey is { } key)
        {
            OnSelectNode.InvokeAsync(key);
        }
        else if (Node.Children.Count > 0)
        {
            ToggleExpanded();
        }
    }

    private void HandleDoubleClick()
    {
        if (Node.Kind != TestNodeKind.Test && Node.ExpansionKey is not null && Node.Children.Count > 0)
        {
            ToggleExpanded();
        }
    }

    private void ToggleExpanded()
    {
        Node.IsExpanded = !Node.IsExpanded;
        OnExpansionChanged?.Invoke(Node);
    }

    private static string StatusIcon(TestNode node)
    {
        if (node.Kind != TestNodeKind.Test)
        {
            // Aggregate status for group/suite nodes
            var allTests = FlattenTests(node);
            if (!allTests.Any()) return "◌";
            if (allTests.Any(t => t.Status == TestStatusDto.Failed))  return "✗";
            if (allTests.Any(t => t.Status == TestStatusDto.Running)) return "⟳";
            if (allTests.Any(t => t.Status == TestStatusDto.Skipped)) return "●";
            if (allTests.All(t => t.Status == TestStatusDto.Passed))  return "✓";
            return "◌";
        }

        return node.Test?.Status switch
        {
            TestStatusDto.Passed  => "✓",
            TestStatusDto.Failed  => "✗",
            TestStatusDto.Skipped => "●",
            TestStatusDto.Running => "⟳",
            _                     => "◌",
        };
    }

    private static string StatusColor(TestNode node)
    {
        if (node.Kind != TestNodeKind.Test)
        {
            var allTests = FlattenTests(node);
            if (!allTests.Any()) return "text-gray-600";
            if (allTests.Any(t => t.Status == TestStatusDto.Failed))  return "text-red-400";
            if (allTests.Any(t => t.Status == TestStatusDto.Running)) return "text-cyan-400";
            if (allTests.Any(t => t.Status == TestStatusDto.Skipped)) return "text-yellow-400";
            if (allTests.All(t => t.Status == TestStatusDto.Passed))  return "text-green-400";
            return "text-gray-600";
        }

        return node.Test?.Status switch
        {
            TestStatusDto.Passed  => "text-green-400",
            TestStatusDto.Failed  => "text-red-400",
            TestStatusDto.Skipped => "text-yellow-400",
            TestStatusDto.Running => "text-cyan-400",
            _                     => "text-gray-600",
        };
    }

    private static IEnumerable<TestResultDto> FlattenTests(TestNode node)
    {
        if (node.Kind == TestNodeKind.Test && node.Test is not null)
        {
            yield return node.Test;
            yield break;
        }

        foreach (var child in node.Children)
        foreach (var test in FlattenTests(child))
            yield return test;
    }
}
