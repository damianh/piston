@inject EngineClientService Client
@inject ViewState _viewState
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="flex flex-col h-full overflow-hidden">

    <!-- Toolbar -->
    <Toolbar Filter="@_filter"
             OnReset="Reset"
             OnExpandAll="() => SetExpanded(true)"
             OnCollapseAll="() => SetExpanded(false)"
             Grouping="@_viewState.Grouping"
             OnGroupingChanged="SetGrouping"
             DetailPosition="@_viewState.DetailPosition"
             OnToggleDetailPosition="ToggleDetailPosition"
             ShowFailed="@_viewState.ShowFailed"
             ShowPassed="@_viewState.ShowPassed"
             ShowSkipped="@_viewState.ShowSkipped"
             ShowNotRun="@_viewState.ShowNotRun"
             OnToggleFailed="() => ToggleStatus(s => s.ShowFailed = !s.ShowFailed)"
             OnTogglePassed="() => ToggleStatus(s => s.ShowPassed = !s.ShowPassed)"
             OnToggleSkipped="() => ToggleStatus(s => s.ShowSkipped = !s.ShowSkipped)"
             OnToggleNotRun="() => ToggleStatus(s => s.ShowNotRun = !s.ShowNotRun)"
             HistoryEnabled="@_historyEnabled"
             OnlyNewFailures="@_viewState.OnlyNewFailures"
             OnlyFlaky="@_viewState.OnlyFlaky"
             OnToggleNewFailures="() => ToggleStatus(s => s.OnlyNewFailures = !s.OnlyNewFailures)"
             OnToggleFlaky="() => ToggleStatus(s => s.OnlyFlaky = !s.OnlyFlaky)"
             FailedCount="@_runFailedCount"
             CanRun="@CanRun"
             OnRunFailed="RunFailedAsync"
             RunFailedError="@_runError"
             OnFilterChanged="SetFilter" />

    <WatchStripBar Snapshot="@_snapshot" OnRevealTest="RevealTestByKey" />

    <!-- Main content area: test tree, resizable splitter, detail panel (docked right or bottom) -->
    <div class="@(_isBottom ? "flex flex-col" : "flex") flex-1 min-h-0 overflow-hidden"
         data-orientation="@(_isBottom ? "bottom" : "right")" @ref="_splitContainer">
        <div class="flex flex-col min-w-0 min-h-0 overflow-hidden" style="flex: 0 0 @(_splitPercentCss)%">
            <div class="flex items-center gap-1 px-2 py-1 shrink-0 bg-gray-950 border-b border-gray-800 text-gray-500 select-none">
                @SortHeader(TestSort.Name, "Name", "flex-1 min-w-0 justify-start")
                @SortHeader(TestSort.Duration, "Duration", "w-14 shrink-0 justify-end")
                <span class="w-4 shrink-0 ml-1" aria-hidden="true"></span>
            </div>
            <TestTree @ref="_tree"
                      Nodes="@_treeNodes"
                      SelectedKey="@_viewState.SelectedTestKey"
                      SelectedProject="@_viewState.SelectedTestProject"
                      SelectedNodeKey="@_viewState.SelectedNodeKey"
                      PinnedFqns="@_viewState.PinnedTestFqns"
                      OnSelectTest="SelectTest"
                      OnSelectNode="SelectNode"
                      OnTogglePin="TogglePin"
                      OnExpansionChanged="RememberExpansion" />
        </div>

        <div data-splitter
             role="separator"
             tabindex="0"
             aria-label="Resize test list and details"
             aria-orientation="@(_isBottom ? "horizontal" : "vertical")"
             aria-valuemin="@ViewState.MinSplitPercent"
             aria-valuemax="@ViewState.MaxSplitPercent"
             aria-valuenow="@Math.Round(_viewState.SplitPercent)"
             title="Drag to resize · double-click to reset"
             class="@(_isBottom
                 ? "h-px w-full cursor-row-resize before:-top-1 before:-bottom-1 before:inset-x-0"
                 : "w-px h-full cursor-col-resize before:-left-1 before:-right-1 before:inset-y-0") relative z-10 shrink-0 bg-gray-800 transition-colors hover:bg-blue-500 focus-visible:bg-blue-500 focus:outline-none data-[dragging]:bg-blue-500 before:absolute before:content-['']"
             @ondblclick="ResetSplit"
             @onkeydown="HandleSplitterKeyDown"
             @onkeydown:stopPropagation="true"></div>

        <div class="flex-1 flex flex-col min-w-0 min-h-0 overflow-hidden">
            @if (_snapshot?.Phase == PistonPhaseDto.Error && _snapshot.LastBuild is not null)
            {
                <BuildErrors Build="@_snapshot.LastBuild" />
            }
            else if (_nodeDetail is not null)
            {
                <GroupDetail @key="_viewState.SelectedNodeKey"
                             Detail="@_nodeDetail"
                             CanRun="@CanRun"
                             OnSelectTest="SelectTest"
                             OnShowProject="SelectProject" />
            }
            else
            {
                <TestDetail @key="_selectedTest?.Key"
                            Test="@_selectedTest"
                            Project="@ProjectOf(_selectedTest)"
                            ProjectLabel="@ProjectLabelOf(_selectedTest)"
                            CanRun="@CanRun"
                            SelectionReasons="@SelectionReasonsOf(_selectedTest)"
                            SolutionPath="@_snapshot?.SolutionPath"
                            OnShowProject="SelectProject" />
            }
        </div>
    </div>

    <!-- Status bar -->
    <SectionContent SectionName="@StatusBar.TabSection">
        <TestsStatusItems Filter="@_filter"
                          FailureCount="@_failureCount"
                          OnPrevFailure="NavigatePrevFailure"
                          OnNextFailure="NavigateNextFailure" />
    </SectionContent>

</div>

@code {
    [Parameter] public KeyboardEventArgs? KeyboardEvent { get; set; }

    private StateSnapshotNotification? _snapshot;
    private List<TestNode> _treeNodes = [];
    private TestResultDto? _selectedTest;
    private NodeDetail? _nodeDetail;
    private string? _filter
    {
        get => _viewState.Filter;
        set => _viewState.Filter = value;
    }
    private int _failureCount;
    private IReadOnlyList<TestSuiteDto> _displayedSuites = [];

    // The parent keeps passing its last key event on every re-render, and a freshly mounted tab
    // receives whatever was pressed before it existed; only act on events not seen yet.
    private KeyboardEventArgs? _lastHandledKeyboardEvent;

    protected override void OnInitialized()
    {
        _lastHandledKeyboardEvent = KeyboardEvent;
        Client.StateChanged += OnStateChanged;
        Client.SettingsChanged += OnSettingsChanged;

        // The tab may mount after the latest snapshot arrived (e.g. on tab switch); start from it.
        if (Client.CurrentSnapshot is { } current)
        {
            _snapshot = current;
            RebuildTree();
        }

        _marksRunTime = Client.CurrentSnapshot?.LastRunTime;
        _ = LoadMarksAsync();
    }

    private bool _historyEnabled;
    private DateTimeOffset? _marksRunTime;

    // Failure kinds change only when a run finishes.
    private async Task LoadMarksAsync()
    {
        if (await Client.GetTestMarksAsync() is not { } marks)
        {
            return;
        }

        _historyEnabled = marks.Enabled;
        var byKey = new Dictionary<(string Project, string Test), TestMarkDto>();
        foreach (var mark in marks.Tests)
        {
            byKey[(mark.ProjectId ?? mark.Project, mark.Test)] = mark;
        }

        _viewState.TestMarks = byKey;
        if (!_historyEnabled)
        {
            _viewState.OnlyNewFailures = false;
            _viewState.OnlyFlaky = false;
        }

        await InvokeAsync(() =>
        {
            RebuildTree();
            StateHasChanged();
        });
    }

    protected override void OnParametersSet()
    {
        if (KeyboardEvent is null || ReferenceEquals(KeyboardEvent, _lastHandledKeyboardEvent))
            return;

        _lastHandledKeyboardEvent = KeyboardEvent;
        HandleKeyDown(KeyboardEvent);
    }

    private void OnStateChanged(StateSnapshotNotification snapshot)
    {
        if (snapshot.LastRunTime != _marksRunTime)
        {
            _marksRunTime = snapshot.LastRunTime;
            _ = LoadMarksAsync();
        }

        _snapshot = snapshot;
        RebuildTree();
        InvokeAsync(StateHasChanged);
    }

    // AppShell applies changed settings to the shared ViewState; re-render to reflect them.
    private void OnSettingsChanged() => InvokeAsync(StateHasChanged);

    private void RebuildTree()
    {
        if (_snapshot is null)
        {
            _treeNodes = [];
            _displayedSuites = [];
            _failureCount = 0;
            _runFailedCount = 0;
            _nodeDetail = null;
            return;
        }

        _displayedSuites = _snapshot.Phase == PistonPhaseDto.Testing
            ? TestTreeBuilder.WithLiveOverlay(_snapshot.Suites, _snapshot.InProgressSuites)
            : _snapshot.Suites;

        _treeNodes = TestTreeBuilder.Build(
            _displayedSuites,
            _filter,
            _viewState,
            _snapshot.LastFileChangeTime,
            TestTreeBuilder.IsDiscovering(_snapshot));

        _runFailedCount = DashboardStatus.FailedCount(_snapshot.Suites);

        _failureCount = _displayedSuites
            .SelectMany(s => s.Tests)
            .Count(t => t.Status == TestStatusDto.Failed);

        if (_viewState.SelectedTestKey is not null)
        {
            // A live result gains its framework when final results arrive, so fall back to the name.
            _selectedTest = _viewState.FindSelectedTest(_displayedSuites);
            if (_selectedTest is not null)
            {
                _viewState.SelectedTestKey = _selectedTest.Key;
                _viewState.SelectedTestProject = ProjectOf(_selectedTest);
                if (_viewState.RevealSelectedTest)
                {
                    _viewState.RevealSelectedTest = false;
                    _scrollToSelected = ExpandAncestors(_treeNodes, _selectedTest.Key, _viewState.SelectedTestProject);
                }
            }
        }

        UpdateNodeDetail();
    }

    private int _runFailedCount;
    private string? _runError;
    private bool _runStarting;

    private void SortTestsBy(TestSort sort)
    {
        _viewState.SortTestsBy(sort);
        RebuildTree();
    }

    private RenderFragment SortHeader(TestSort sort, string label, string classes) =>
        @<text>
            @{
                var active = _viewState.TestSort == sort;
                var descending = active ? _viewState.TestSortDescending : sort == TestSort.Duration;
                var order = sort == TestSort.Name
                    ? (descending ? "Z to A" : "A to Z")
                    : (descending ? "slowest first" : "fastest first");
                var hint = active ? $"Sorted {order}. Click to reverse." : $"Sort {order}";
            }
            <button type="button"
                    class="@classes flex items-center gap-1 rounded text-[10px] font-semibold hover:text-gray-200 focus:outline-none focus-visible:ring-1 focus-visible:ring-blue-500 @(active ? "text-gray-300" : "")"
                    title="@hint" aria-label="@($"{label}: {hint}")"
                    @onclick="() => SortTestsBy(sort)">
                @label
                <span class="w-2 text-center" aria-hidden="true">@(active ? (descending ? "▾" : "▴") : "")</span>
            </button>
        </text>;

    private Task RunFailedAsync() =>
        _snapshot is not null && DashboardStatus.RunFailed(_snapshot.Suites) is { } command
            ? RunAsync(command)
            : Task.CompletedTask;

    // Runs whatever the details pane shows: a group's tests, or the selected test.
    private Task RunSelectionAsync()
    {
        var command = _nodeDetail is not null
            ? _nodeDetail.Run
            : _selectedTest is not null && ProjectOf(_selectedTest) is { } project
                ? new RunTestsCommand([project], [_selectedTest.FullyQualifiedName])
                : null;
        return command is null ? Task.CompletedTask : RunAsync(command);
    }

    private async Task RunAsync(RunTestsCommand command)
    {
        if (_runStarting || !CanRun)
        {
            return;
        }

        _runStarting = true;
        _runError = null;
        try
        {
            _runError = await Client.RunTestsAsync(command);
        }
        catch (Exception ex)
        {
            _runError = ex.Message;
        }
        finally
        {
            _runStarting = false;
            StateHasChanged();
        }
    }

    // A targeted run is refused while another is in progress.
    private bool CanRun =>
        Client.IsConnected && _snapshot?.Phase is PistonPhaseDto.Idle or PistonPhaseDto.Watching or PistonPhaseDto.Error;

    private void UpdateNodeDetail() =>
        _nodeDetail = _viewState.SelectedNodeKey is { } key && _snapshot is not null
            ? NodeDetail.For(key, _displayedSuites, _snapshot.Suites, _treeNodes)
            : null;

    private string? ProjectOf(TestResultDto? test) =>
        test is null ? null : _displayedSuites.FirstOrDefault(s => s.Tests.Any(t => ReferenceEquals(t, test))) is { } suite
            ? suite.ProjectId ?? suite.Name
            : null;

    private string? ProjectLabelOf(TestResultDto? test) =>
        ProjectOf(test) is { } project ? TestTreeBuilder.DisplayProjectName(_displayedSuites, project) : null;

    // Why the last run selected the test, when the impact map narrowed it by changed lines.
    private IReadOnlyList<TestSelectionReasonDto>? SelectionReasonsOf(TestResultDto? test) =>
        test is null ? null : _snapshot?.LastRun?.SelectionReasons?.GetValueOrDefault(test.FullyQualifiedName);

    private void SelectTest(TestResultDto test)
    {
        _viewState.SelectedNodeKey = null;
        _nodeDetail = null;
        _viewState.SelectedTestKey = test.Key;
        _viewState.SelectedTestProject = ProjectOf(test);
        _selectedTest = test;
        StateHasChanged();
    }

    /// <summary>Selects <paramref name="test"/>, expanding its ancestors and scrolling it into view.</summary>
    private void RevealTest(TestResultDto test)
    {
        _scrollToSelected = ExpandAncestors(_treeNodes, test.Key, ProjectOf(test));
        SelectTest(test);
    }

    private void RevealTestByKey(TestOutcomeReferenceDto reference)
    {
        if (_snapshot?.Suites.Where(s => (s.ProjectId ?? s.Name) == (reference.ProjectId ?? reference.Project))
            .SelectMany(s => s.Tests).FirstOrDefault(t => t.Key == reference.Key) is { } test)
        {
            RevealTest(test);
        }
    }

    private void SelectProject(string project) => SelectNode($"suite:{project}");

    private void SelectNode(string key)
    {
        _viewState.SelectedTestKey = null;
        _viewState.SelectedTestProject = null;
        _selectedTest = null;
        _viewState.SelectedNodeKey = key;
        UpdateNodeDetail();
        StateHasChanged();
    }

    private void TogglePin(string fqn)
    {
        if (!_viewState.PinnedTestFqns.Remove(fqn))
            _viewState.PinnedTestFqns.Add(fqn);
        RebuildTree();
        StateHasChanged();
    }

    private async Task Reset()
    {
        _selectedTest = null;
        await Client.ResetAsync();
    }

    private void ToggleExpand() => SetExpanded(!_viewState.TreeExpanded);

    private void SetExpanded(bool expanded)
    {
        _viewState.TreeExpanded = expanded;
        _viewState.NodeExpansion.Clear();
        SetExpandedRecursive(_treeNodes, expanded);
        StateHasChanged();
    }

    private void RememberExpansion(TestNode node)
    {
        if (node.ExpansionKey is { } key)
        {
            _viewState.NodeExpansion[key] = node.IsExpanded;
        }
    }

    private static void SetExpandedRecursive(List<TestNode> nodes, bool expanded)
    {
        foreach (var node in nodes)
        {
            node.IsExpanded = expanded;
            SetExpandedRecursive(node.Children, expanded);
        }
    }

    private async Task SetFilter(string? filter)
    {
        _filter = filter;
        RebuildTree();
        await Client.SetFilterAsync(filter);
        await InvokeAsync(StateHasChanged);
    }

    private void CycleGrouping() =>
        SetGrouping(_viewState.Grouping switch
        {
            GroupingMode.ProjectNamespaceClass => GroupingMode.ByStatus,
            GroupingMode.ByStatus              => GroupingMode.Flat,
            _                                  => GroupingMode.ProjectNamespaceClass,
        });

    private void SetGrouping(GroupingMode mode)
    {
        _viewState.Grouping = mode;
        RebuildTree();
        StateHasChanged();
    }

    private void ToggleStatus(Action<ViewState> toggle)
    {
        toggle(_viewState);
        RebuildTree();
        StateHasChanged();
    }

    private void NavigatePrevFailure()
    {
        if (_failureCount == 0) return;
        var failures = GetFailedTests();
        if (failures.Count == 0) return;
        _viewState.CurrentFailureIndex = (_viewState.CurrentFailureIndex - 1 + failures.Count) % failures.Count;
        RevealTest(failures[_viewState.CurrentFailureIndex]);
    }

    private void NavigateNextFailure()
    {
        if (_failureCount == 0) return;
        var failures = GetFailedTests();
        if (failures.Count == 0) return;
        _viewState.CurrentFailureIndex = (_viewState.CurrentFailureIndex + 1) % failures.Count;
        RevealTest(failures[_viewState.CurrentFailureIndex]);
    }

    private List<TestResultDto> GetFailedTests() =>
        _displayedSuites
            .SelectMany(s => s.Tests)
            .Where(t => t.Status == TestStatusDto.Failed)
            .ToList();

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key.ToUpperInvariant())
        {
            case "G": CycleGrouping(); break;
            case "E": ToggleExpand(); break;
            case "1": ToggleStatus(s => s.ShowFailed  = !s.ShowFailed);  break;
            case "2": ToggleStatus(s => s.ShowPassed  = !s.ShowPassed);  break;
            case "3": ToggleStatus(s => s.ShowSkipped = !s.ShowSkipped); break;
            case "4": ToggleStatus(s => s.ShowNotRun  = !s.ShowNotRun);  break;
            case "[": NavigatePrevFailure(); break;
            case "]": NavigateNextFailure(); break;
            case "S": SortTestsBy(TestSort.Duration); break;
            case "R": _ = RunSelectionAsync(); break;
        }
    }

    // ── Split layout ──

    private ElementReference _splitContainer;
    private DotNetObjectReference<TestsTab>? _selfRef;
    private bool _isBottom => _viewState.DetailPosition == DetailPosition.Bottom;
    private string _splitPercentCss =>
        _viewState.SplitPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private bool _scrollToSelected;
    private TestTree? _tree;

    /// <summary>Expands every collapsed ancestor of the test with <paramref name="key"/>; false when it is not in the tree.</summary>
    private bool ExpandAncestors(IEnumerable<TestNode> nodes, string key, string? project)
    {
        foreach (var node in nodes)
        {
            if (node.Test?.Key == key && (project is null || node.Project == project))
            {
                return true;
            }

            if (ExpandAncestors(node.Children, key, project))
            {
                if (!node.IsExpanded && node.ExpansionKey is { } expansionKey)
                {
                    node.IsExpanded = true;
                    _viewState.NodeExpansion[expansionKey] = true;
                }

                return true;
            }
        }

        return false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollToSelected)
        {
            _scrollToSelected = false;
            if (_tree is not null)
            {
                await _tree.RevealSelectedAsync();
            }
        }

        if (!firstRender)
            return;

        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("pistonSplitter.attach", _splitContainer, _selfRef,
            ViewState.MinSplitPercent, ViewState.MaxSplitPercent);
    }

    [JSInvokable]
    public void SetSplit(double percent)
    {
        _viewState.SplitPercent = percent;
        StateHasChanged();
    }

    private void ResetSplit() => _viewState.ResetSplit();

    private void ToggleDetailPosition()
    {
        _viewState.DetailPosition = _isBottom ? DetailPosition.Right : DetailPosition.Bottom;
        _ = Client.UpdateSettingsAsync(new UserSettings(_viewState.ToSettings()));
    }

    private void HandleSplitterKeyDown(KeyboardEventArgs e)
    {
        var step = e.ShiftKey ? 1 : 5;
        var delta = (e.Key, _isBottom) switch
        {
            ("ArrowLeft", false) or ("ArrowUp", true) => -step,
            ("ArrowRight", false) or ("ArrowDown", true) => step,
            _ => 0,
        };

        if (e.Key == "Home")
            _viewState.SplitPercent = ViewState.MinSplitPercent;
        else if (e.Key == "End")
            _viewState.SplitPercent = ViewState.MaxSplitPercent;
        else if (e.Key == "Enter")
            _viewState.ResetSplit();
        else if (delta != 0)
            _viewState.SplitPercent += delta;
    }

    public async ValueTask DisposeAsync()
    {
        Client.StateChanged -= OnStateChanged;
        Client.SettingsChanged -= OnSettingsChanged;

        try
        {
            await JS.InvokeVoidAsync("pistonSplitter.detach", _splitContainer);
        }
        catch (JSDisconnectedException)
        {
        }

        _selfRef?.Dispose();
    }
}
