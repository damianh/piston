@inject IJSRuntime JS

<button class="ml-auto mr-2 p-1.5 rounded text-gray-400 hover:text-gray-100 hover:bg-gray-800 transition-colors"
        title="@Title (click to change)" aria-label="@Title" @onclick="CycleAsync">
    @switch (_preference)
    {
        case "light":
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
                <circle cx="8" cy="8" r="3" />
                <path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06" />
            </svg>
            break;
        case "dark":
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true">
                <path d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z" />
            </svg>
            break;
        default:
            <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="1.75" y="2.5" width="12.5" height="8.5" rx="1.5" />
                <path d="M5.5 14h5M8 11v3" />
            </svg>
            break;
    }
</button>

@code {
    private static readonly string[] Order = ["system", "light", "dark"];

    private string _preference = "system";

    private string Title => _preference switch
    {
        "light" => "Theme: light",
        "dark"  => "Theme: dark",
        _       => "Theme: match system",
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var saved = await JS.InvokeAsync<string>("pistonTheme.get");
        if (saved != _preference && Order.Contains(saved))
        {
            _preference = saved;
            StateHasChanged();
        }
    }

    private async Task CycleAsync()
    {
        _preference = Order[(Array.IndexOf(Order, _preference) + 1) % Order.Length];
        await JS.InvokeVoidAsync("pistonTheme.set", _preference);
    }
}
