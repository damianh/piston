@using Piston.Protocol.Dtos

<div class="flex items-center gap-2 px-4 py-1.5 shrink-0 bg-gray-900 border-b border-gray-800 text-xs select-none">
    <!-- Reset -->
    <button class="px-2 py-1 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded transition-colors"
            title="Reset: reload the project graph, clear results and coverage, re-discover and run all tests"
            aria-label="Reset" @onclick="OnReset">
        ⟲
    </button>

    <!-- Expand/collapse all -->
    <div class="flex items-center gap-1">
        <button class="px-2 py-1 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded transition-colors"
                title="Expand all" aria-label="Expand all" @onclick="OnExpandAll">
            ⊞
        </button>
        <button class="px-2 py-1 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded transition-colors"
                title="Collapse all" aria-label="Collapse all" @onclick="OnCollapseAll">
            ⊟
        </button>
    </div>

    <!-- Status visibility toggles -->
    <div class="flex items-center gap-0.5 ml-2 p-0.5 bg-gray-800 rounded" role="group" aria-label="Show tests by status">
        <button class="@ToggleClass(ShowFailed, "text-red-400")" title="Show failed (1)" aria-label="Show failed"
                aria-pressed="@(ShowFailed ? "true" : "false")" @onclick="OnToggleFailed">✗</button>
        <button class="@ToggleClass(ShowPassed, "text-green-400")" title="Show passed (2)" aria-label="Show passed"
                aria-pressed="@(ShowPassed ? "true" : "false")" @onclick="OnTogglePassed">✓</button>
        <button class="@ToggleClass(ShowSkipped, "text-yellow-400")" title="Show skipped (3)" aria-label="Show skipped"
                aria-pressed="@(ShowSkipped ? "true" : "false")" @onclick="OnToggleSkipped">●</button>
        <button class="@ToggleClass(ShowNotRun, "text-gray-300")" title="Show not run (4)" aria-label="Show not run"
                aria-pressed="@(ShowNotRun ? "true" : "false")" @onclick="OnToggleNotRun">◌</button>
    </div>

    <!-- Grouping mode -->
    <div class="relative ml-2">
        <select class="appearance-none bg-gray-800 border border-gray-700 rounded pl-2 pr-6 py-0.5 leading-4 text-gray-200 text-xs cursor-pointer hover:border-gray-600 focus:outline-none focus:border-blue-500"
                title="Group tests by (G to cycle)" aria-label="Group tests by"
                value="@Grouping" @onchange="HandleGroupingChange">
            <option value="@GroupingMode.ProjectNamespaceClass">Project tree</option>
            <option value="@GroupingMode.ByStatus">By status</option>
            <option value="@GroupingMode.Flat">Flat list</option>
        </select>
        <svg class="pointer-events-none absolute right-1.5 top-1/2 -translate-y-1/2 w-2.5 h-2.5 text-gray-400"
             viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 3.5 5 6.5 8 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
    </div>

    <!-- Filter input -->
    <div class="flex items-center gap-1">
        <input type="text"
               class="bg-gray-800 border border-gray-700 rounded px-2 py-0.5 text-gray-200 text-xs w-48 focus:outline-none focus:border-blue-500"
               placeholder="filter…"
               title="Filter tests by regex or substring"
               aria-label="Filter tests"
               value="@Filter"
               @oninput="HandleFilterInput"
               @onkeydown="HandleFilterKeyDown" />
        @if (!string.IsNullOrEmpty(Filter))
        {
            <button class="text-gray-600 hover:text-gray-400" @onclick="ClearFilter">✕</button>
        }
    </div>

    <!-- Detail panel dock position; the icon previews the layout the click switches to -->
    @{
        var dockLabel = DetailPosition == DetailPosition.Right ? "Dock details at bottom" : "Dock details on right";
    }
    <button class="ml-auto p-1 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded transition-colors"
            title="@dockLabel" aria-label="@dockLabel" @onclick="OnToggleDetailPosition">
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="1.5" y="2.5" width="13" height="11" rx="1.5" stroke="currentColor" />
            @if (DetailPosition == DetailPosition.Right)
            {
                <rect x="2" y="8.5" width="12" height="4.5" rx="1" fill="currentColor" />
            }
            else
            {
                <rect x="8.5" y="3" width="5.5" height="10" rx="1" fill="currentColor" />
            }
        </svg>
    </button>
</div>

@code {
    [Parameter] public string? Filter { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback OnExpandAll { get; set; }
    [Parameter] public EventCallback OnCollapseAll { get; set; }
    [Parameter] public EventCallback<string?> OnFilterChanged { get; set; }
    [Parameter] public GroupingMode Grouping { get; set; }
    [Parameter] public EventCallback<GroupingMode> OnGroupingChanged { get; set; }
    [Parameter] public DetailPosition DetailPosition { get; set; }
    [Parameter] public EventCallback OnToggleDetailPosition { get; set; }
    [Parameter] public bool ShowFailed { get; set; } = true;
    [Parameter] public bool ShowPassed { get; set; } = true;
    [Parameter] public bool ShowSkipped { get; set; } = true;
    [Parameter] public bool ShowNotRun { get; set; } = true;
    [Parameter] public EventCallback OnToggleFailed { get; set; }
    [Parameter] public EventCallback OnTogglePassed { get; set; }
    [Parameter] public EventCallback OnToggleSkipped { get; set; }
    [Parameter] public EventCallback OnToggleNotRun { get; set; }

    private System.Timers.Timer? _debounceTimer;

    private static string ToggleClass(bool on, string onColor) =>
        "w-6 py-0.5 rounded text-center transition-colors " +
        (on ? $"bg-gray-700 {onColor} hover:bg-gray-600" : "text-gray-600 hover:text-gray-400 hover:bg-gray-700/50");

    private Task HandleGroupingChange(ChangeEventArgs e) =>
        Enum.TryParse<GroupingMode>(e.Value?.ToString(), out var mode)
            ? OnGroupingChanged.InvokeAsync(mode)
            : Task.CompletedTask;

    private void HandleFilterInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Timers.Timer(300);
        _debounceTimer.Elapsed += async (_, _) =>
        {
            _debounceTimer?.Dispose();
            _debounceTimer = null;
            await OnFilterChanged.InvokeAsync(string.IsNullOrEmpty(value) ? null : value);
        };
        _debounceTimer.AutoReset = false;
        _debounceTimer.Start();
    }

    private void HandleFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            ClearFilter();
    }

    private void ClearFilter()
    {
        _debounceTimer?.Dispose();
        _debounceTimer = null;
        OnFilterChanged.InvokeAsync(null);
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}
