@using Piston.Protocol.Dtos

<div class="flex items-center gap-2 px-4 py-1.5 shrink-0 bg-gray-900 border-b border-gray-800 text-xs select-none">
    <!-- Force run -->
    <button class="px-2 py-1 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded transition-colors"
            title="Force run (R)" @onclick="OnForceRun">
        ▶ Run
    </button>

    <!-- Reset: two-step so a stray click doesn't discard results and restart discovery -->
    <button class="@(_resetArmed
                ? "px-2 py-1 bg-amber-600 hover:bg-amber-500 text-white rounded transition-colors"
                : "px-2 py-1 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded transition-colors")"
            title="Reset: reload the project graph, clear results and coverage, re-discover and run all tests"
            @onclick="HandleResetClick" @onblur="DisarmReset">
        @(_resetArmed ? "⟲ Confirm reset?" : "⟲ Reset")
    </button>

    <!-- Expand/collapse all -->
    <div class="flex items-center gap-1">
        <button class="px-2 py-1 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded transition-colors"
                title="Expand all" aria-label="Expand all" @onclick="OnExpandAll">
            ⊞
        </button>
        <button class="px-2 py-1 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded transition-colors"
                title="Collapse all" aria-label="Collapse all" @onclick="OnCollapseAll">
            ⊟
        </button>
    </div>

    <!-- Filter input -->
    <div class="flex items-center gap-1 ml-2">
        <span class="text-gray-600">filter:</span>
        <input type="text"
               class="bg-gray-800 border border-gray-700 rounded px-2 py-0.5 text-gray-200 text-xs w-48 focus:outline-none focus:border-blue-500"
               placeholder="regex or substring..."
               value="@Filter"
               @oninput="HandleFilterInput"
               @onkeydown="HandleFilterKeyDown" />
        @if (!string.IsNullOrEmpty(Filter))
        {
            <button class="text-gray-600 hover:text-gray-400" @onclick="ClearFilter">✕</button>
        }
    </div>

    <!-- Detail panel dock position; the icon previews the layout the click switches to -->
    @{
        var dockLabel = DetailPosition == DetailPosition.Right ? "Dock details at bottom" : "Dock details on right";
    }
    <button class="ml-auto p-1 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded transition-colors"
            title="@dockLabel" aria-label="@dockLabel" @onclick="OnToggleDetailPosition">
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <rect x="1.5" y="2.5" width="13" height="11" rx="1.5" stroke="currentColor" />
            @if (DetailPosition == DetailPosition.Right)
            {
                <rect x="2" y="8.5" width="12" height="4.5" rx="1" fill="currentColor" />
            }
            else
            {
                <rect x="8.5" y="3" width="5.5" height="10" rx="1" fill="currentColor" />
            }
        </svg>
    </button>
</div>

@code {
    [Parameter] public string? Filter { get; set; }
    [Parameter] public EventCallback OnForceRun { get; set; }
    [Parameter] public EventCallback OnReset { get; set; }
    [Parameter] public EventCallback OnExpandAll { get; set; }
    [Parameter] public EventCallback OnCollapseAll { get; set; }
    [Parameter] public EventCallback<string?> OnFilterChanged { get; set; }
    [Parameter] public DetailPosition DetailPosition { get; set; }
    [Parameter] public EventCallback OnToggleDetailPosition { get; set; }

    private System.Timers.Timer? _debounceTimer;
    private bool _resetArmed;
    private CancellationTokenSource? _disarmCts;

    private async Task HandleResetClick()
    {
        if (!_resetArmed)
        {
            _resetArmed = true;
            _disarmCts?.Cancel();
            _disarmCts = new CancellationTokenSource();
            var token = _disarmCts.Token;
            _ = Task.Delay(TimeSpan.FromSeconds(4), token).ContinueWith(
                _ => InvokeAsync(() => { _resetArmed = false; StateHasChanged(); }),
                token, TaskContinuationOptions.OnlyOnRanToCompletion, TaskScheduler.Default);
            return;
        }

        DisarmReset();
        await OnReset.InvokeAsync();
    }

    private void DisarmReset()
    {
        _disarmCts?.Cancel();
        _resetArmed = false;
    }

    private void HandleFilterInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Timers.Timer(300);
        _debounceTimer.Elapsed += async (_, _) =>
        {
            _debounceTimer?.Dispose();
            _debounceTimer = null;
            await OnFilterChanged.InvokeAsync(string.IsNullOrEmpty(value) ? null : value);
        };
        _debounceTimer.AutoReset = false;
        _debounceTimer.Start();
    }

    private void HandleFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            ClearFilter();
    }

    private void ClearFilter()
    {
        _debounceTimer?.Dispose();
        _debounceTimer = null;
        OnFilterChanged.InvokeAsync(null);
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
        _disarmCts?.Cancel();
    }
}
