<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>piston</ToolCommandName>
    <PackageId>Piston</PackageId>
    <Version>0.1.0</Version>
    <Authors>Damian Hickey</Authors>
    <Description>Continuous .NET test backend with stdio and HTTP MCP test tools and a web dashboard.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/damianh/piston</RepositoryUrl>
    <PackageProjectUrl>https://github.com/damianh/piston</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Piston.Engine\Piston.Engine.csproj" />
    <ProjectReference Include="..\Piston.Protocol\Piston.Protocol.csproj" />
    <!--
      Piston.Web is published and its static files are copied to wwwroot (see BlazorWebUI.targets).
      This reference only orders the build; Private="false" stops its runtimeconfig and json
      content from being copied into this project's output and the packed tool.
    -->
    <ProjectReference Include="..\Piston.Web\Piston.Web.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Piston.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Harness integration assets installed by `piston init`. The canvas is the repository's own extension. -->
  <ItemGroup>
    <EmbeddedResource Include="Integration\Assets\SKILL.md" LogicalName="Piston.Integration/skill/SKILL.md" />
    <EmbeddedResource Include="..\..\.github\extensions\piston-dashboard\*"
                      Exclude="..\..\.github\extensions\piston-dashboard\*.test.mjs"
                      LogicalName="Piston.Integration/canvas/%(Filename)%(Extension)"
                      Link="Integration\Assets\canvas\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Publish Piston.Web and copy its wwwroot output to our wwwroot -->
  <Import Project="..\BlazorWebUI.targets" />
</Project>
