<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>piston</ToolCommandName>
    <PackageId>Piston</PackageId>
    <Version>0.1.0</Version>
    <Authors>Damian Hickey</Authors>
    <Description>Continuous .NET test backend with a web dashboard and HTTP MCP test tools.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/damianh/piston</RepositoryUrl>
    <PackageProjectUrl>https://github.com/damianh/piston</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Piston.Engine\Piston.Engine.csproj" />
    <ProjectReference Include="..\Piston.Hosting\Piston.Hosting.csproj" />
    <ProjectReference Include="..\Piston.Protocol\Piston.Protocol.csproj" />
    <!-- Piston.Web is published and its static files are copied to wwwroot -->
    <ProjectReference Include="..\Piston.Web\Piston.Web.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Piston.Protocol.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Publish Piston.Web and copy its wwwroot output to our wwwroot -->
  <Import Project="..\BlazorWebUI.targets" />
</Project>
