<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Piston.Engine\Piston.Engine.csproj" />
    <ProjectReference Include="..\Piston.Hosting\Piston.Hosting.csproj" />
    <ProjectReference Include="..\Piston.Protocol\Piston.Protocol.csproj" />
    <!-- Piston.Web is published and its static files are copied to wwwroot -->
    <ProjectReference Include="..\Piston.Web\Piston.Web.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Piston.Protocol.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Publish Piston.Web and copy its wwwroot output to our wwwroot -->
  <Import Project="..\BlazorWebUI.targets" />
</Project>
