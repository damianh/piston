<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>piston</ToolCommandName>
    <PackageId>DamianH.Piston</PackageId>
    <PackageType>DotnetTool;McpServer</PackageType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Authors>Damian Hickey</Authors>
    <Description>Continuous .NET test backend with stdio and HTTP MCP test tools and a web dashboard.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/damianh/piston</RepositoryUrl>
    <PackageProjectUrl>https://github.com/damianh/piston</PackageProjectUrl>
  </PropertyGroup>
  <!--
    The tool ships as RID-specific packages behind the DamianH.Piston pointer package. The Windows packages
    start through Launcher/piston.cmd, which runs Piston from a per-build copy outside the .NET tool store so
    `dotnet tool update` works while Piston is running. Every other platform uses the framework-dependent
    'any' package and the dotnet runner.
  -->
  <PropertyGroup>
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;any</ToolPackageRuntimeIdentifiers>
    <RuntimeIdentifiers>$(ToolPackageRuntimeIdentifiers)</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <ToolCommandRunner>executable</ToolCommandRunner>
    <ToolEntryPoint>piston.cmd</ToolEntryPoint>
    <UseAppHost>false</UseAppHost>
    <SelfContained>false</SelfContained>
  </PropertyGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <None Include="Launcher\piston.cmd;Launcher\piston-run.cmd" Link="%(Filename)%(Extension)"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The NuGet README is intentionally separate from the repository README. -->
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <!-- MCP registry metadata belongs to the DamianH.Piston pointer package only. -->
  <Target Name="GenerateMcpMetadata" BeforeTargets="_GetPackageFiles" Condition="'$(RuntimeIdentifier)' == ''">
    <PropertyGroup>
      <_McpMetadata>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/Integration/server.json').Replace('@VERSION@', '$(PackageVersion)'))</_McpMetadata>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)server.json" Lines="$(_McpMetadata)" Overwrite="true" />
    <ItemGroup>
      <None Include="$(IntermediateOutputPath)server.json" Pack="true" PackagePath="/.mcp/" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Piston.Engine\Piston.Engine.csproj" />
    <ProjectReference Include="..\Piston.Protocol\Piston.Protocol.csproj" />
    <!--
      Piston.Web is published and its static files are copied to wwwroot (see BlazorWebUI.targets).
      This reference only orders the build; Private="false" stops its runtimeconfig and json
      content from being copied into this project's output and the packed tool.
    -->
    <ProjectReference Include="..\Piston.Web\Piston.Web.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Piston.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Harness integration assets installed by `piston init`. The canvas is the repository's own extension. -->
  <ItemGroup>
    <EmbeddedResource Include="Integration\Assets\SKILL.md" LogicalName="Piston.Integration/skill/SKILL.md" />
    <EmbeddedResource Include="..\..\.github\extensions\piston-dashboard\*"
                      Exclude="..\..\.github\extensions\piston-dashboard\*.test.mjs"
                      LogicalName="Piston.Integration/canvas/%(Filename)%(Extension)"
                      Link="Integration\Assets\canvas\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Publish Piston.Web and copy its wwwroot output to our wwwroot -->
  <Import Project="..\BlazorWebUI.targets" />

  <!--
    Names the launcher's runtime copy after the version and a hash of the published files, so a rebuilt
    package with the same version never reuses a stale copy.
  -->
  <Target Name="WritePistonRuntimeId" AfterTargets="PublishBlazorWebUIOnPublish"
          Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <ItemGroup>
      <_PistonPayload Include="$(PublishDir)**\*" Exclude="$(PublishDir)piston.runtime-id">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
      </_PistonPayload>
    </ItemGroup>
    <GetFileHash Files="@(_PistonPayload)">
      <Output TaskParameter="Items" ItemName="_PistonPayloadHash" />
    </GetFileHash>
    <WriteLinesToFile File="$(IntermediateOutputPath)piston-payload.txt"
                      Lines="@(_PistonPayloadHash->'%(RelativePath) %(FileHash)')" Overwrite="true" />
    <GetFileHash Files="$(IntermediateOutputPath)piston-payload.txt">
      <Output TaskParameter="Hash" PropertyName="_PistonPayloadDigest" />
    </GetFileHash>
    <WriteLinesToFile File="$(PublishDir)piston.runtime-id"
                      Lines="$(PackageVersion)-$(_PistonPayloadDigest.Substring(0, 16).ToLowerInvariant())"
                      Overwrite="true" />
  </Target>
</Project>
