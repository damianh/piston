    <None Include="..\Piston.TestProcessHost\bin\$(Configuration)\$(TargetFramework)\Piston.TestProcessHost.runtimeconfig.json"
          Link="Piston.TestProcessHost.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

