<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.analyzers" />
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.core.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Piston.Protocol\Piston.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Piston\Piston.csproj" />
  </ItemGroup>

  <!-- Pure dashboard models; Piston.Web is a WebAssembly app, so they are compiled in rather than referenced -->
  <ItemGroup>
    <Compile Include="..\..\src\Piston.Web\Models\AssertionDiff.cs" Link="Web\AssertionDiff.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\CoverageTree.cs" Link="Web\CoverageTree.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\DashboardStatus.cs" Link="Web\DashboardStatus.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\TestNode.cs" Link="Web\TestNode.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\RunComparison.cs" Link="Web\RunComparison.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\TestHistoryStrip.cs" Link="Web\TestHistoryStrip.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\TestRetries.cs" Link="Web\TestRetries.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\TestTreeBuilder.cs" Link="Web\TestTreeBuilder.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\ViewState.cs" Link="Web\ViewState.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\NodeDetail.cs" Link="Web\NodeDetail.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\ProjectLabels.cs" Link="Web\ProjectLabels.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\TreeRow.cs" Link="Web\TreeRow.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\StackTraceParser.cs" Link="Web\StackTraceParser.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\CSharpHighlighter.cs" Link="Web\CSharpHighlighter.cs" />
    <Compile Include="..\..\src\Piston.Web\Models\WatchStrip.cs" Link="Web\WatchStrip.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\src\Piston.Web\wwwroot\js\status.js" Link="Web\status.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
